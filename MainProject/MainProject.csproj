<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChaySocial.MainProject</RootNamespace>
    <!-- Declaring RuntimeIdentifiers here would mark this library as RID-specific, and the
         .NET Android SDK's per-RID inner build (which runs with SkipCompilerExecution=true)
         would then push RuntimeIdentifier down into it. That inner pass writes no assembly,
         so the copy to the output directory fails with MSB3030. Staying RID-agnostic keeps
         every consumer head reusing the single obj\Debug\net10.0 output. -->
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.90" />
    <PackageReference Include="Plugin.Firebase" Version="4.2.1" />
  </ItemGroup>
	<!-- The generator is always taken from its Debug build, whatever configuration this library is built in.
	     Windows Smart App Control refuses to load a freshly produced unsigned assembly it has no reputation for,
	     and a Release build of the generator is exactly that: the compiler reports CS8034 ("Unable to load
	     Generators ... blocked by Application Control policy"), skips the generator, and every page then fails
	     with "NavigationConstants does not exist" — a compile error that looks nothing like its cause. Which
	     configuration a source generator itself was compiled in cannot change the code it emits, so pinning it
	     costs nothing and keeps one binary in play instead of two. -->
	<ItemGroup>
		<ProjectReference Include="..\Generators\Generators.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false"
		                  SetConfiguration="Configuration=Debug" />
	</ItemGroup>
</Project>


