@*
    Styling for WrittenLine. WrittenLine renders this component itself, so a written line always arrives with
    its own CSS attached. Every selector is namespaced "written-line-*" because *Css.razor styles are global.
*@
<style>
    /* A named account: brand-coloured and underlined only under the pointer, so a line full of names still reads
       as a sentence rather than as a row of buttons. */
    .written-line-name {
        color: @(AppColors.PrimaryLight.ToRgbaHex(true));
        font-weight: @(AppMeasures.Weight.Medium);
        text-decoration: none;
        overflow-wrap: anywhere;
    }

    /* A named subject, in the second brand colour so the two kinds of name are told apart at a glance. */
    .written-line-subject {
        color: @(AppColors.Secondary.ToRgbaHex(true));
        font-weight: @(AppMeasures.Weight.Medium);
        text-decoration: none;
        overflow-wrap: anywhere;
    }

        .written-line-name:hover,
        .written-line-subject:hover {
            text-decoration: underline;
        }

    /* The curtain. Deliberately quiet: it names what the line was read as and offers to open it, and it does not
       look like a warning, a punishment or an official ruling — because it is none of those. It is the reader's own
       setting, applied on the reader's own device, and it is one tap from being gone. */
    .written-line-curtain {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px dashed @(AppColors.BorderSoft.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        cursor: pointer;
        text-align: left;
    }

        .written-line-curtain:hover {
            border-style: solid;
            color: @(AppColors.TextSecondary.ToRgbaHex(true));
        }

        /* What the line was read as, in the app's own words rather than a category code. */
        .written-line-curtain-reason {
            font-style: italic;
        }

        .written-line-curtain-open {
            font-weight: @(AppMeasures.Weight.Medium);
            color: @(AppColors.PrimaryLight.ToRgbaHex(true));
            white-space: nowrap;
        }
</style>
