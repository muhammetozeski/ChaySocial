@using ChaySocial.MainProject.DataModels
@using ChaySocial.MainProject.Text

<CoreCard Acrylic="AcrylicLevel.Normal"
          AcrylicBlur="@AppMeasures.Blur.Normal"
          TextColor="@AppColors.TextPrimary"
          BorderRadius="@(AppMeasures.Radius.XLarge + "px")"
          Padding="@(AppMeasures.Space.Px20 + "px")"
          CustomClass="post-composer">

    <div class="post-composer-row">
        <span class="post-composer-avatar">@AvatarEmoji</span>
        <textarea class="post-composer-input"
                  rows="@VisibleRowCount"
                  placeholder="@ComposerPlaceholder"
                  disabled="@IsBusy"
                  value="@Text"
                  @oninput="HandleTextInput"></textarea>
    </div>

    @if (QuotedPost is not null)
    {
        <div class="post-composer-quote">
            <QuotedPost Post="@QuotedPost" AuthorProfile="@QuotedAuthorProfile" />

            <button type="button"
                    class="post-composer-quote-drop"
                    title="@DropQuoteHint"
                    disabled="@IsBusy"
                    @onclick="OnCancelQuote">@DropQuoteEmoji</button>
        </div>
    }

    <div class="post-composer-tools">
        <MentionPicker OnPick="NameSomebodyAsync" IsDisabled="@IsBusy" />

        <MediaPicker Attachments="@Attachments"
                     AttachmentsChanged="@AttachmentsChanged"
                     IsDisabled="@IsBusy" />

        <PollComposer Choices="@PollChoices"
                      ChoicesChanged="@PollChoicesChanged"
                      IsDisabled="@IsBusy" />

        <DrawingPicker Attachments="@Attachments"
                       AttachmentsChanged="@AttachmentsChanged"
                       IsDisabled="@IsBusy" />

        @* These two are last, because opening either takes a whole line and a control that pushed the ones after
           it onto their own lines would scatter a row that reads as one row. *@
        <LongFormComposer Title="@Title"
                          TitleChanged="@TitleChanged"
                          LongBody="@LongBody"
                          LongBodyChanged="@LongBodyChanged"
                          IsDisabled="@IsBusy" />

        <ReplyCirclePicker Circle="@ReplyCircle"
                           CircleChanged="@ReplyCircleChanged"
                           IsDisabled="@IsBusy" />
    </div>

    @* Both shown to the writer only, before anything is sent. Neither reports nor blocks anything: the first says
       how the line will read to somebody else, the second says which of this device's accounts it sounds like. *@
    <WritingMirror Text="@Text" />
    <StyleMirror Draft="@DraftWriting" WritingAsAddress="@WritingAsAddress" />

    <div class="post-composer-footer">
        <span class="post-composer-counter" style="@CounterStyle">@CounterLabel</span>

        @* CoreButton is used directly rather than PrimaryButton because the pill radius, padding and font size
           are written as inline style by CoreButton itself — a class rule could never win against them. *@
        <CoreButton Disabled="@(!CanSubmit)"
                    OnClick="HandleSubmit"
                    Gradient="@((AppColors.Primary, AppColors.Secondary))"
                    TextColor="@AppColors.TextOnAccent"
                    BorderRadius="@(AppMeasures.Radius.Pill + "px")"
                    Padding="@ShareButtonPadding"
                    FontSize="@AppMeasures.Font.Normal"
                    Shadow="@AppStyles.ShadowPrimaryGlow"
                    CustomClass="post-composer-share">
            @if (IsBusy)
            {
                <CoreSpinner SizePx="@BusySpinnerSizePx"
                             BorderWidthPx="@BusySpinnerBorderWidthPx"
                             Color="@AppColors.TextOnAccent" />
            }
            else
            {
                <span class="post-composer-share-icon">@ShareEmoji</span>
                <span>@ShareLabel</span>
            }
        </CoreButton>
    </div>

</CoreCard>

<PostComposerCss />

@code {
    /// <summary> Invitation shown in the empty textarea. A caller can change it, so a group's composer can ask about that room rather than about the wall. </summary>
    [Parameter] public string ComposerPlaceholder { get; set; } = DefaultPlaceholder;

    /// <summary> The invitation used when a caller supplies none; it keeps the app's tea-house voice. </summary>
    const string DefaultPlaceholder = "What is steeping today?";

    /// <summary> Marks the publish button. </summary>
    const string ShareEmoji = "✨";

    /// <summary> Text on the publish button. </summary>
    const string ShareLabel = "Share";

    /// <summary> Word after the count while there is still room left. </summary>
    const string CharactersLeftLabel = "left";

    /// <summary> Word after the count once the text runs past the limit. </summary>
    const string CharactersOverLabel = "over";

    /// <summary> Text lines the textarea shows before it starts scrolling. </summary>
    const int VisibleRowCount = 3;

    /// <summary>
    /// How close to <see cref="PostData.MaximumTextLength"/> the text gets before the counter turns amber: the
    /// last stretch where a writer wants warning that they are running out of room.
    /// </summary>
    const int WarningRemainingCharacterCount = 60;

    /// <summary> Diameter of the throbber that replaces the button's label while a post is being published. </summary>
    const int BusySpinnerSizePx = AppMeasures.Size.Px16;

    /// <summary> Ring thickness of that throbber, thinned down so a small circle still reads as a ring. </summary>
    const int BusySpinnerBorderWidthPx = AppMeasures.Border.Medium;

    /// <summary> Inside spacing of the share button: a wide pill that stays comfortable to tap on a phone. </summary>
    static readonly string ShareButtonPadding = $"{AppMeasures.Space.Px10}px {AppMeasures.Space.Px20}px";

    /// <summary> What the writer has typed so far. </summary>
    [Parameter] public string Text { get; set; } = string.Empty;

    /// <summary> Raised on every keystroke with the textarea's new contents, so the page owns the text. </summary>
    [Parameter] public EventCallback<string> TextChanged { get; set; }

    /// <summary> Raised when the writer presses the share button on text that is publishable. </summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    /// <summary> True while the page is publishing; the textarea locks and the button shows a throbber. </summary>
    [Parameter] public bool IsBusy { get; set; }

    /// <summary> Emoji drawn in the composer's bubble, normally the signed-in account's own avatar. </summary>
    [Parameter] public string Avatar { get; set; } = ProfileData.DefaultAvatar;

    /// <summary>
    /// Address this post will actually go out under, which is the reader's own account unless they picked a page.
    /// Only the style mirror reads it, and only to leave that account out of what it compares the draft against —
    /// sounding like yourself is not worth a line.
    /// </summary>
    [Parameter] public string WritingAsAddress { get; set; } = string.Empty;

    /// <summary> Media already attached to the post being written. </summary>
    [Parameter] public IReadOnlyList<MediaAttachment> Attachments { get; set; } = [];

    /// <summary> Raised whenever the attached set changes, so the page owns it alongside the text. </summary>
    [Parameter] public EventCallback<IReadOnlyList<MediaAttachment>> AttachmentsChanged { get; set; }

    /// <summary> Line set above a long piece, or empty when the post is not one. </summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary> Hands the title back to the page that owns it. </summary>
    [Parameter] public EventCallback<string> TitleChanged { get; set; }

    /// <summary> The whole of a long piece, or empty for an ordinary post. </summary>
    [Parameter] public string LongBody { get; set; } = string.Empty;

    /// <summary> Hands the piece back to the page that owns it. </summary>
    [Parameter] public EventCallback<string> LongBodyChanged { get; set; }

    /// <summary> Answers this post is offering, blanks included; empty when it is not asking anything. </summary>
    [Parameter] public IReadOnlyList<string> PollChoices { get; set; } = [];

    /// <summary> Hands the answers back to the page that owns them. </summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> PollChoicesChanged { get; set; }

    /// <summary> Who may answer the post being written; anybody, unless the writer narrows it. </summary>
    [Parameter] public ReplyCircle ReplyCircle { get; set; } = ReplyCircle.Anyone;

    /// <summary> Hands that choice back to the page that owns it. </summary>
    [Parameter] public EventCallback<ReplyCircle> ReplyCircleChanged { get; set; }

    /// <summary> Post the writer is quoting, or null when they are writing a plain post. </summary>
    [Parameter] public PostData? QuotedPost { get; set; }

    /// <summary> Profile of the quoted post's author, or null when it could not be read. </summary>
    [Parameter] public ProfileData? QuotedAuthorProfile { get; set; }

    /// <summary> Raised when the writer drops the quote and goes back to a plain post. </summary>
    [Parameter] public EventCallback OnCancelQuote { get; set; }

    /// <summary> Mark on the control that drops the quote. </summary>
    const string DropQuoteEmoji = "✕";

    /// <summary> Hover text on that control. </summary>
    const string DropQuoteHint = "Write without quoting";

    /// <summary> The bubble emoji, falling back to the starter avatar when the page passed nothing. </summary>
    string AvatarEmoji => string.IsNullOrEmpty(Avatar) ? ProfileData.DefaultAvatar : Avatar;

    /// <summary>
    /// Everything being written here, folded the way a published post is. The style mirror reads this rather than
    /// the line alone: a long piece is written in the same card and is the part that carries a fingerprint best,
    /// and the accounts the draft is compared against were measured over all three fields.
    /// </summary>
    string DraftWriting => StyleService.WritingOf(Text ?? string.Empty, Title ?? string.Empty, LongBody ?? string.Empty);

    /// <summary>
    /// Length of what would actually be published. The publish path trims before it measures, so counting the
    /// trimmed text is what makes the counter agree with whether the post is accepted.
    /// </summary>
    int PublishableLength => (Text ?? string.Empty).Trim().Length;

    /// <summary> Room left before the limit; negative once the text is too long. </summary>
    int RemainingCharacterCount => PostData.MaximumTextLength - PublishableLength;

    /// <summary> The counter's text: how much room is left, or how far past the limit the text has gone. </summary>
    string CounterLabel => RemainingCharacterCount >= 0
        ? $"{RemainingCharacterCount} {CharactersLeftLabel}"
        : $"{-RemainingCharacterCount} {CharactersOverLabel}";

    /// <summary>
    /// Colours the counter by how much room is left: muted with room to spare, amber once the end is in sight,
    /// and the danger colour once the text no longer fits.
    /// </summary>
    string CounterStyle
    {
        get
        {
            Color counterColor = RemainingCharacterCount switch
            {
                < 0 => AppColors.TextDanger,
                <= WarningRemainingCharacterCount => AppColors.TextWarning,
                _ => AppColors.TextMuted
            };

            return $"color:{counterColor.ToRgbaHex(true)};";
        }
    }

    /// <summary>
    /// True when the share button should accept a tap. A post needs something to say — words, media, somebody
    /// else's post, or a question with real answers in it — and must not run past the text limit, and no publish
    /// may already be running.
    /// </summary>
    bool CanSubmit => !IsBusy
        && OnSubmit.HasDelegate
        && (PublishableLength > 0 || Attachments.Count > 0 || QuotedPost is not null || IsAskingSomething || IsWritingAPiece)
        && PublishableLength <= PostData.MaximumTextLength;

    /// <summary> True once there is a whole piece to publish, which is a post even with no line above it. </summary>
    bool IsWritingAPiece => LongBody.Trim().Length > 0;

    /// <summary>
    /// True when the answers typed so far make a question. One filled box is somebody still typing, not a poll,
    /// and the same rule is enforced again in the service so this is a courtesy rather than the gate.
    /// </summary>
    bool IsAskingSomething => PollChoices.Count(choice => choice.Trim().Length > 0) >= PostData.LeastPollChoiceCount;

    /// <summary> Hands each keystroke's text back to the page that owns it. </summary>
    /// <param name="args"> The input event carrying the textarea's new contents. </param>
    /// <returns> A task that completes once the page has taken the new text. </returns>
    Task HandleTextInput(ChangeEventArgs args)
        => TextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    /// <summary>
    /// Writes a chosen account into what is being typed. The name goes on the end with a space before and after,
    /// so it lands as its own word wherever the writer is in the sentence and they can keep typing straight after.
    /// </summary>
    /// <param name="address"> Address of the account that was picked. </param>
    /// <returns> A task that completes once the page has taken the longer text. </returns>
    Task NameSomebodyAsync(string address)
    {
        string separator = Text.Length == 0 || char.IsWhiteSpace(Text[^1]) ? string.Empty : " ";
        return TextChanged.InvokeAsync($"{Text}{separator}{WrittenText.AccountMark}{address} ");
    }

    /// <summary> Raises <see cref="OnSubmit"/>, and does nothing when the current text is not publishable. </summary>
    /// <returns> A task that completes once the page has handled the share. </returns>
    Task HandleSubmit() => CanSubmit ? OnSubmit.InvokeAsync() : Task.CompletedTask;
}
