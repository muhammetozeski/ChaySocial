@*
    Styling for the card and the link that saves it. The card itself carries all its own colours, so there is
    almost nothing to style here: it is a picture, and the page only has to give it room.
*@
<style>
    .identity-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
    }

    /* The drawing scales to whatever room the sheet has; its own viewBox keeps its shape. */
    .identity-card-drawing {
        width: @(AppMeasures.Percent.Full)%;
        line-height: @(AppMeasures.LineHeight.None);
    }

        .identity-card-drawing svg {
            display: block;
            width: @(AppMeasures.Percent.Full)%;
            height: auto;
            border-radius: @(AppMeasures.Radius.Large)px;
        }

    .identity-card-save {
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px20)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: linear-gradient(@(SaveGradientAngleDegrees)deg, @(AppColors.Primary.ToRgbaHex(true)), @(AppColors.Secondary.ToRgbaHex(true)));
        color: @(AppColors.TextOnAccent.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Medium);
        text-decoration: none;
    }

    .identity-card-note {
        margin: 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        text-align: center;
    }
</style>

@code {
    /// <summary> Direction the save link's fill runs in, matching every other gradient in the app. </summary>
    const int SaveGradientAngleDegrees = 135;
}
