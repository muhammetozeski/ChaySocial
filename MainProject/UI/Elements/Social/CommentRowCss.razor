@*
    Styling for CommentRow. CommentRow renders this component itself, so a reply always arrives with its
    own CSS attached.
*@
<style>
    .comment-row {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px14)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        box-sizing: border-box;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        backdrop-filter: blur(@(AppMeasures.Blur.Subtle)px);
        -webkit-backdrop-filter: blur(@(AppMeasures.Blur.Subtle)px);
        animation: comment-row-arrive @(AppMeasures.Duration.Medium)s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    /* Round emoji chip standing in for the author's picture. */
    .comment-row-avatar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: @(AvatarDiameterPx)px;
        height: @(AvatarDiameterPx)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
        background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderTop.ToRgbaHex(true));
    }

    /* min-width:0 lets a long unbroken word shrink the column instead of pushing the delete button off the row. */
    .comment-row-body {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        flex: 1;
        min-width: 0;
    }

    .comment-row-heading {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .comment-row-name {
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    .comment-row-separator {
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .comment-row-time {
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    /* pre-wrap keeps the author's own line breaks; overflow-wrap stops a pasted address from widening the card. */
    .comment-row-text {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* Sizes the CoreButton the author deletes with; it stays quiet until pointed at. */
    .comment-row-delete {
        flex-shrink: 0;
        align-self: center;
        width: @(DeleteButtonDiameterPx)px;
        height: @(DeleteButtonDiameterPx)px;
        opacity: @(AppMeasures.Opacity.Dim);
        transition: opacity @(AppMeasures.Duration.Fast)s;
    }

        .comment-row-delete:hover:not(:disabled) {
            opacity: 1;
        }

    @@keyframes comment-row-arrive {
        from {
            opacity: 0;
            transform: translateY(@(ArrivalRisePx)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    /// <summary> Side of the round emoji chip. Deliberately smaller than a post's avatar so a reply reads as secondary to the post it hangs under. </summary>
    const int AvatarDiameterPx = AppMeasures.Size.Px36;

    /// <summary> Side of the round delete button, small enough to sit inside the row without crowding the text. </summary>
    const int DeleteButtonDiameterPx = AppMeasures.Size.Px28;

    /// <summary> How far the reply slides up as it fades in. </summary>
    const int ArrivalRisePx = AppMeasures.Space.Px8;
}
