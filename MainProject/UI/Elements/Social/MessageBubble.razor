@using ChaySocial.MainProject.Services

@*
    One direct message in a conversation. The signed-in account's own messages sit on the right in a filled
    indigo gradient; the other side's sit on the left on glass. A message this device could not decrypt is
    drawn as a quiet padlocked line rather than as a blank bubble, and every bubble carries a seal saying
    whether the sender's signature checked out.
*@
<div class="message-bubble-line @LineSideClass">
    <div class="message-bubble @BubbleSideClass" style="@BubbleStyle">
        @if (QuotedSummary is not null)
        {
            @* The quoted line sits inside the bubble and above its words, so a reply reads as an answer to
               something rather than as a message that happens to mention it. *@
            <button type="button" class="message-bubble-quote" style="@QuoteStyle" @onclick="OnOpenQuoted">
                <span class="message-bubble-quote-mark">@QuoteMark</span>
                <span class="message-bubble-quote-text">@QuotedSummary</span>
            </button>
        }

        @if (IsVanishing && !IsVanishingOpened)
        {
            @* A vanishing message stays behind a deliberate tap: opening it destroys it on the server, so it
               must never happen just because the conversation scrolled past. *@
            <button type="button"
                    class="message-bubble-vanishing"
                    disabled="@(IsMine || IsOpening)"
                    @onclick="OnOpenVanishing">
                @if (IsOpening)
                {
                    <CoreSpinner SizePx="@VanishingSpinnerSizePx" BorderWidthPx="@VanishingSpinnerBorderPx" />
                }
                else
                {
                    <span class="message-bubble-vanishing-emoji">@VanishingEmoji</span>
                }
                <span>@(IsMine ? VanishingSentLabel : VanishingOpenLabel)</span>
            </button>
        }
        else if (CouldDecrypt)
        {
            @if (Text.Length > 0)
            {
                <p class="message-bubble-text">@Text</p>
            }

            @* A vanishing letter's media is already in hand and exists nowhere else, so it is drawn from the bytes
               the reader was handed rather than fetched again — there is nothing left to fetch. *@
            @foreach (RevealedMedia revealed in RevealedMedia)
            {
                <img class="message-bubble-media"
                     src="@MediaService.BuildDataUri(revealed.Content, revealed.Attachment.ContentType)"
                     alt="@revealed.Attachment.Description" />
            }

            @foreach (MediaAttachment attachment in StoredAttachments)
            {
                <MediaView Attachment="@attachment" @key="attachment.BlobId" />
            }

            @if (IsVanishing)
            {
                <p class="message-bubble-vanishing-note">@VanishingGoneNote</p>
            }
        }
        else
        {
            <p class="message-bubble-locked">
                <span class="message-bubble-locked-emoji">@LockedEmoji</span>
                @UnreadableMessageText
            </p>
        }

        <div class="message-bubble-footer">
            @if (OnReply.HasDelegate && CouldDecrypt)
            {
                <button type="button" class="message-bubble-reply" title="@ReplyHint" @onclick="OnReply">@ReplyEmoji</button>
            }

            <span class="message-bubble-time">@SentAgo</span>

            @if (IsSenderVerified)
            {
                <span class="message-bubble-seal" title="@VerifiedSealTitle">@VerifiedEmoji</span>
            }
            else
            {
                <span class="message-bubble-seal message-bubble-seal--unverified" title="@UnverifiedSealTitle">@UnverifiedEmoji</span>
            }
        </div>
    </div>
</div>

<MessageBubbleCss />

@code {
    /// <summary> The decrypted message body. Ignored when <see cref="CouldDecrypt"/> is false. </summary>
    [Parameter] public string Text { get; set; } = string.Empty;

    /// <summary> True when the signed-in account sent this message, which puts it on the right in a filled bubble. </summary>
    [Parameter] public bool IsMine { get; set; }

    /// <summary> When the sender sent it. </summary>
    [Parameter] public long CreatedAtUnixMs { get; set; }

    /// <summary> True when the sender's signature checked out against the key their profile publishes. </summary>
    [Parameter] public bool IsSenderVerified { get; set; }

    /// <summary> False when this device could not turn the stored ciphertext back into text; the bubble then shows the padlocked line instead of <see cref="Text"/>. </summary>
    [Parameter] public bool CouldDecrypt { get; set; } = true;

    /// <summary> True when this message may be read exactly once, which puts it behind a tap. </summary>
    [Parameter] public bool IsVanishing { get; set; }

    /// <summary> True once the reader has opened this vanishing message and <see cref="Text"/> holds its body. </summary>
    [Parameter] public bool IsVanishingOpened { get; set; }

    /// <summary> True while the vanishing body is being fetched, which shows a throbber in place of the invitation. </summary>
    [Parameter] public bool IsOpening { get; set; }

    /// <summary> Raised when the reader taps a vanishing message, which is what destroys it on the server. </summary>
    [Parameter] public EventCallback OnOpenVanishing { get; set; }

    /// <summary> Media recovered from a vanishing message, already decrypted and held only in memory. </summary>
    [Parameter] public IReadOnlyList<RevealedMedia> RevealedMedia { get; set; } = [];

    /// <summary> Media still sitting in the blob store, which an ordinary message's bubble fetches when it draws. </summary>
    [Parameter] public IReadOnlyList<MediaAttachment> StoredAttachments { get; set; } = [];

    /// <summary> One line of the message this one replies to, already shortened by the page; null when it replies to nothing. </summary>
    [Parameter] public string? QuotedSummary { get; set; }

    /// <summary> Raised when the quoted line is tapped, to jump to the message it stands for. </summary>
    [Parameter] public EventCallback OnOpenQuoted { get; set; }

    /// <summary> Raised when the reader wants to reply to this message. The action only appears when a caller wires this up. </summary>
    [Parameter] public EventCallback OnReply { get; set; }

    /// <summary> Mark drawn before a quoted line. </summary>
    const string QuoteMark = "❝";

    /// <summary> Mark on the action that replies to a message. </summary>
    const string ReplyEmoji = "↩";

    /// <summary> Hover text on that action. </summary>
    const string ReplyHint = "Reply to this message";

    /// <summary> Opacity of the quoted line's own ground inside a filled bubble. </summary>
    const float QuoteGroundOpacity = 0.18f;

    /// <summary>
    /// The quoted line's ground. Inside the account's own filled bubble a translucent black film reads correctly
    /// against the gradient; on a glass bubble the palette's subtle surface does.
    /// </summary>
    string QuoteStyle => IsMine
        ? $"background:{Colors.Black.WithAlpha(QuoteGroundOpacity).ToRgbaHex(true)};border:{AppStyles.BorderStrokeSoft};"
        : $"background:{AppColors.SurfaceSubtle.ToRgbaHex(true)};border:{AppStyles.BorderStrokeSoft};";

    /// <summary> Mark on the invitation to open a vanishing message. </summary>
    const string VanishingEmoji = "👁️";

    /// <summary> Wording on that invitation, for the reader it was sent to. </summary>
    const string VanishingOpenLabel = "Tap to read once";

    /// <summary> Wording shown to the sender, who cannot open their own vanishing message. </summary>
    const string VanishingSentLabel = "Sent to be read once";

    /// <summary> Line under a vanishing message that has been opened, saying it is now gone. </summary>
    const string VanishingGoneNote = "This message is gone from the server.";

    /// <summary> Diameter of the throbber shown while a vanishing body is fetched. </summary>
    const int VanishingSpinnerSizePx = 14;

    /// <summary> Ring thickness of that throbber. </summary>
    const int VanishingSpinnerBorderPx = 2;

    /// <summary> Modifier pushing the bubble to the right edge of the conversation column. </summary>
    const string MineLineClass = "message-bubble-line--mine";

    /// <summary> Modifier holding the bubble at the left edge of the conversation column. </summary>
    const string TheirsLineClass = "message-bubble-line--theirs";

    /// <summary> Modifier tightening the bubble's bottom-right corner. </summary>
    const string MineBubbleClass = "message-bubble--mine";

    /// <summary> Modifier tightening the bubble's bottom-left corner. </summary>
    const string TheirsBubbleClass = "message-bubble--theirs";

    /// <summary> Shown in place of the body when the ciphertext could not be opened on this device. </summary>
    const string UnreadableMessageText = "Can't open this message";

    /// <summary> Emoji beside the unreadable-message line. </summary>
    const string LockedEmoji = "🔐";

    /// <summary> Seal shown when the sender's signature verified. </summary>
    const string VerifiedEmoji = "🔏";

    /// <summary> Seal shown when the sender's signature did not verify. </summary>
    const string UnverifiedEmoji = "⚠️";

    /// <summary> Hover text on the verified seal. </summary>
    const string VerifiedSealTitle = "Signed by the sender's own key";

    /// <summary> Hover text on the unverified seal. </summary>
    const string UnverifiedSealTitle = "This message's signature could not be checked";

    /// <summary> Direction the filled bubble's sheen runs, top-left to bottom-right. </summary>
    const string MineFillSheenAngle = "135deg";

    /// <summary> Strength of the indigo halo under the signed-in account's own bubbles. </summary>
    const float MineFillGlowOpacity = 0.35f;

    /// <summary> Which side of the conversation column this message hangs on. </summary>
    string LineSideClass => IsMine ? MineLineClass : TheirsLineClass;

    /// <summary> Which corner of the bubble is tightened into a tail. </summary>
    string BubbleSideClass => IsMine ? MineBubbleClass : TheirsBubbleClass;

    /// <summary> How long ago the message was sent, in the app's short "3h" form. </summary>
    string SentAgo => RelativeTimeFormatter.Format(CreatedAtUnixMs);

    /// <summary>
    /// The bubble's fill. An unopenable message drops to the faintest glass on either side, because muted
    /// placeholder text would be unreadable over the filled gradient; otherwise the account's own messages
    /// take the indigo gradient with a halo, and the other side's take plain glass.
    /// </summary>
    string BubbleStyle
    {
        get
        {
            if (!CouldDecrypt)
            {
                return AppStyles.BuildAcrylicStyle(AcrylicLevel.Subtle, AppMeasures.Blur.Subtle)
                     + $"color:{AppColors.TextMuted.ToRgbaHex(true)};";
            }

            if (IsMine)
            {
                return $"background:linear-gradient({MineFillSheenAngle}, {AppColors.Primary.ToRgbaHex(true)}, {AppColors.PrimaryDark.ToRgbaHex(true)});"
                     + $"color:{AppColors.TextOnFilledSurface.ToRgbaHex(true)};"
                     + $"box-shadow:{AppStyles.GetGlow(AppColors.Primary, MineFillGlowOpacity)};";
            }

            return AppStyles.BuildAcrylicStyle(AcrylicLevel.Normal, AppMeasures.Blur.Subtle)
                 + $"color:{AppColors.TextPrimary.ToRgbaHex(true)};";
        }
    }
}
