@using ChaySocial.MainProject.DataModels

@*
    Styling for the control that opens the board and for the surface the board sits on.
*@
<style>
    .drawing-picker {
        display: flex;
        align-items: center;
    }

    /* Sized and coloured to match the poll button beside it, so the composer's tool row reads as one row of
       controls rather than as a button that happens to be nearby. */
    .drawing-picker-open {
        display: flex;
        align-items: center;
        justify-content: center;
        width: @(OpenButtonDiameterPx)px;
        height: @(OpenButtonDiameterPx)px;
        padding: 0;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        cursor: pointer;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.None);
        transition: background @(AppMeasures.Duration.Fast)s, border-color @(AppMeasures.Duration.Fast)s;
    }

        .drawing-picker-open:hover:not(:disabled) {
            background: @(AppColors.SurfaceStrong.ToRgbaHex(true));
            border-color: @(AppColors.Primary.ToRgbaHex(true));
        }

        .drawing-picker-open.is-chosen {
            border-color: @(AppColors.Primary.ToRgbaHex(true));
            background: @(AppColors.SurfaceStrong.ToRgbaHex(true));
        }

        .drawing-picker-open:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }

    .drawing-picker-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        @AppStyles.BuildBackdropFrost()
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        padding: @(BackdropInsetPx)px;
        overscroll-behavior: contain;
        z-index: @(AppMeasures.ZLayer.Modal);
        animation: drawing-picker-arrive @(AppMeasures.Duration.Normal)s ease-out;
    }

    /* Wide enough for the board, the hairline drawn around it and this panel's own padding, and no wider: the
       board is a fixed size, a panel that outgrew it would only add empty glass, and a panel two pixels short of
       it puts a scrollbar under a drawing. */
    .drawing-picker-panel {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(DrawingSheet.DrawingCanvasWidthPx + BoardFrameWidthPx + PanelInsetPx + PanelInsetPx)px;
        max-height: @(AppMeasures.Viewport.Most)vh;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: @(PanelInsetPx)px;
        border-radius: @(AppMeasures.Radius.XLarge)px;
        box-shadow: @AppStyles.ShadowHeavy;
    }

    .drawing-picker-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .drawing-picker-caption {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px14)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-family: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
    }

        .drawing-picker-caption::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
        }

        .drawing-picker-caption:focus {
            outline: none;
            border-color: @(AppColors.Primary.ToRgbaHex(true));
        }

        .drawing-picker-caption:disabled {
            opacity: @(AppMeasures.Opacity.Dim);
        }

    .drawing-picker-message {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextDanger.ToRgbaHex(true));
    }

    .drawing-picker-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px12)px;
        width: @(AppMeasures.Percent.Full)%;
    }

    .drawing-picker-quiet {
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px16)px;
        border: none;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: transparent;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        cursor: pointer;
        font-family: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
    }

        .drawing-picker-quiet:hover:not(:disabled) {
            color: @(AppColors.TextPrimary.ToRgbaHex(true));
        }

        .drawing-picker-quiet:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }

    @@keyframes drawing-picker-arrive {
        from {
            opacity: 0;
        }
    }
</style>

@code {
    /// <summary> Diameter of the button that opens the board, matched to the poll button it stands beside. </summary>
    const int OpenButtonDiameterPx = AppMeasures.Size.Px32;

    /// <summary>
    /// Room left between the board's panel and the edge of the screen. Small on purpose: the board is a fixed size
    /// and cannot shrink to make room, so every pixel spent here is a pixel the narrowest screen has to spare.
    /// </summary>
    const int BackdropInsetPx = AppMeasures.Space.Px8;

    /// <summary> Room inside the panel, around the board and the controls under it. </summary>
    const int PanelInsetPx = AppMeasures.Space.Px16;

    /// <summary>
    /// How much wider the board is than its own drawing area: the hairline down each side. The board cannot use
    /// border-box sizing — that would shrink the area the strokes are drawn against and pull every point away
    /// from where the pointer reported it — so the frame is added to the panel instead.
    /// </summary>
    const int BoardFrameWidthPx = AppMeasures.Border.Thin * 2;
}
