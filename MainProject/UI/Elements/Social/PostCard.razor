@using ChaySocial.MainProject.DataModels
@using ChaySocial.MainProject.Services

@if (Post is not null)
{
    <CoreCard Acrylic="AcrylicLevel.Normal"
              AcrylicBlur="@AppMeasures.Blur.Normal"
              TextColor="@AppColors.TextPrimary"
              BorderRadius="@(AppMeasures.Radius.XLarge + "px")"
              Padding="@(AppMeasures.Space.Px20 + "px")"
              CustomClass="post-card">

        @if (RepostedByName is not null)
        {
            @* Says whose wall carried this post here before the post itself, the way a forwarded letter keeps the
               hand that passed it on visible above the original. *@
            <button type="button" class="post-card-carried" title="@OpenReposterHint" @onclick="HandleOpenReposter">
                <span class="post-card-carried-icon">@RepostEmoji</span>
                <span class="post-card-carried-text">@RepostedByName @CarriedLabel</span>
            </button>
        }

        <div class="post-card-header">
            <button type="button" class="post-card-identity" title="@OpenAuthorHint" @onclick="HandleOpenAuthor">
                @* The feed is where a copied name and emoji would do their work, so the author's own mark goes here. *@
                <span class="post-card-avatar">
                    <IdentitySigil Address="@Post.AuthorAddress" />
                    <span class="post-card-avatar-face">@AvatarEmoji</span>
                </span>
                <span class="post-card-identity-text">
                    <span class="post-card-name">@DisplayName</span>
                    <span class="post-card-address">@ShortenedAddress</span>
                </span>
            </button>
            <span class="post-card-time" title="@PublishedAtHint">@RelativeTime</span>
        </div>

        @if (!IsSignatureTrusted)
        {
            <div class="post-card-badge-row">
                <CoreChip Icon="@UnverifiedEmoji"
                          Text="@UnverifiedLabel"
                          Background="@AppColors.SurfaceTintAccent"
                          TextColor="@AppColors.TextWarning"
                          FontSize="@AppMeasures.Font.XSmall"
                          PaddingX="@AppMeasures.Space.Px10"
                          PaddingY="@AppMeasures.Space.Px4"
                          BorderRadius="@(AppMeasures.Radius.Pill + "px")"
                          Border="@UnverifiedChipBorder" />
            </div>
        }

        @if (Post.Text.Length > 0)
        {
            <p class="post-card-text"><WrittenLine Text="@Post.Text" /></p>
        }

        @* Drawn under the question's own words, because the choices are an answer to them rather than a thing of
           their own. A post that is not asking anything renders nothing here. *@
        <PollView Post="@Post" />

        @foreach (MediaAttachment attachment in Post.Attachments)
        {
            <MediaView Attachment="@attachment" @key="attachment.BlobId" />
        }

        @if (Post.IsQuoting)
        {
            <QuotedPost Post="@QuotedPost" AuthorProfile="@QuotedAuthorProfile" OnOpen="OnOpenQuoted" />
        }

        <div class="post-card-actions">
            @* The app's own gesture rather than a heart: a glass of tea, poured when it is given. *@
            <button type="button"
                    class="post-card-action post-card-action--like @(IsLiked ? LikedModifierClass : string.Empty)"
                    title="@(IsLiked ? UnlikeHint : LikeHint)"
                    @onclick="HandleLike">
                <span class="post-card-action-icon">@(IsLiked ? PouredGlassEmoji : EmptyGlassEmoji)</span>
                <span class="post-card-action-count">@ChayCountLabel</span>
            </button>

            <button type="button" class="post-card-action" title="@CommentsHint" @onclick="HandleOpenComments">
                <span class="post-card-action-icon">@CommentEmoji</span>
                <span class="post-card-action-count">@CommentCount</span>
            </button>

            @if (OnRepost.HasDelegate)
            {
                <button type="button"
                        class="post-card-action post-card-action--repost @(IsReposted ? RepostedModifierClass : string.Empty)"
                        title="@(IsReposted ? UndoRepostHint : RepostHint)"
                        @onclick="HandleRepost">
                    <span class="post-card-action-icon">@RepostEmoji</span>
                    <span class="post-card-action-count">@RepostCount</span>
                </button>
            }

            @if (CanBeTipped)
            {
                <button type="button"
                        class="post-card-action post-card-action--tip"
                        title="@TipHint"
                        @onclick="() => isTipOpen = true">
                    <span class="post-card-action-icon">@TipEmoji</span>
                </button>
            }

            @if (OnQuote.HasDelegate)
            {
                <button type="button" class="post-card-action" title="@QuoteHint" @onclick="HandleQuote">
                    <span class="post-card-action-icon">@QuoteEmoji</span>
                </button>
            }

            @if (ShowDeleteAction)
            {
                <button type="button"
                        class="post-card-action post-card-action--danger post-card-action--trailing"
                        title="@DeleteHint"
                        @onclick="HandleDelete">
                    <span class="post-card-action-icon">@DeleteEmoji</span>
                </button>
            }
            else if (ShowReportAction)
            {
                <button type="button"
                        class="post-card-action post-card-action--trailing"
                        title="@ReportHint"
                        @onclick="HandleReport">
                    <span class="post-card-action-icon">@ReportEmoji</span>
                </button>
            }
        </div>

    </CoreCard>

    @* Nothing here moves money: the address is shown so the reader can pay it from their own wallet, which is
       also the only shape that keeps the server out of it entirely. *@
    <CoreModal IsVisible="@isTipOpen" IsAcrylic="true" OnBackdropClick="() => isTipOpen = false">
        <div class="post-card-tip">
            <span class="post-card-tip-emoji">@TipEmoji</span>
            <h2 class="post-card-tip-title">@TipSheetTitle @DisplayName</h2>
            <p class="post-card-tip-text">@TipSheetDescription</p>

            <span class="post-card-tip-chain">@AuthorProfile?.TipCurrency</span>

            @* A read-only field rather than a copy button: selecting text needs no script, and this app writes none. *@
            <input class="post-card-tip-address"
                   type="text"
                   readonly
                   value="@AuthorProfile?.TipAddress"
                   aria-label="@TipAddressLabel" />

            <p class="post-card-tip-note">@TipSheetNote</p>

            <CoreButton OnClick="() => isTipOpen = false"
                        Background="@AppColors.SurfaceSubtle"
                        TextColor="@AppColors.TextSecondary"
                        BorderRadius="@(AppMeasures.Radius.Pill + "px")"
                        Padding="@TipCloseButtonPadding"
                        FontSize="@AppMeasures.Font.Normal">
                @TipCloseLabel
            </CoreButton>
        </div>
    </CoreModal>
}

<PostCardCss />

@code {
    /// <summary> Glass drawn once the reader has given this post a chay. </summary>
    const string PouredGlassEmoji = "🍵";

    /// <summary> Glass drawn while they have not. </summary>
    const string EmptyGlassEmoji = "🫗";

    /// <summary> Word after a count of one. </summary>
    const string SingleChayWord = "chay";

    /// <summary> Word after any other count. </summary>
    const string ManyChaysWord = "chays";

    /// <summary> Marks the comment count. </summary>
    const string CommentEmoji = "💬";

    /// <summary> Marks both the action that carries this post onto the reader's own wall and the line saying who already did. </summary>
    const string RepostEmoji = "🔁";

    /// <summary> Follows the reposter's name on the line above a carried post. </summary>
    const string CarriedLabel = "passed this on";

    /// <summary> Tooltip on that line. </summary>
    const string OpenReposterHint = "Open the profile that passed this on";

    /// <summary> Tooltip on the repost action while the reader has not carried this post. </summary>
    const string RepostHint = "Pass this on to your own wall";

    /// <summary> Tooltip on it once they have. </summary>
    const string UndoRepostHint = "Take this back off your wall";

    /// <summary> Class appended to the repost action while the reader has carried this post; it carries the lit colours. </summary>
    const string RepostedModifierClass = "is-reposted";

    /// <summary> Marks the action that offers to send the author a little money. </summary>
    const string TipEmoji = "🫖";

    /// <summary> Tooltip on that action, in the app's own words for it. </summary>
    const string TipHint = "Buy them a chay";

    /// <summary> Leads the author's name in the sheet's heading. </summary>
    const string TipSheetTitle = "Buy a chay for";

    /// <summary> Line under that heading, saying plainly who is and is not involved. </summary>
    const string TipSheetDescription =
        "Send it from your own wallet. Nothing goes through us — we only carry the address, and its owner signed it.";

    /// <summary> Line under the address, on what the app can and cannot promise about it. </summary>
    const string TipSheetNote = "The signature proves the account published this address. It cannot prove the address is a good one.";

    /// <summary> Spoken label on the address field, for a screen reader. </summary>
    const string TipAddressLabel = "Payment address";

    /// <summary> Label on the button that closes the sheet. </summary>
    const string TipCloseLabel = "Done";

    /// <summary> Inside spacing of that button. </summary>
    static readonly string TipCloseButtonPadding = $"{AppMeasures.Space.Px10}px {AppMeasures.Space.Px20}px";

    /// <summary> True while the sheet showing the author's payment address is open. </summary>
    bool isTipOpen;

    /// <summary>
    /// True when this author publishes somewhere to send money and the signature over it holds. A profile whose
    /// signature fails is drawn with no way to pay at all, because the alternative is sending money to whoever
    /// tampered with the record.
    /// </summary>
    bool CanBeTipped;

    /// <summary> Marks the action that quotes this post into a new one. </summary>
    const string QuoteEmoji = "❝";

    /// <summary> Hover text on that action. </summary>
    const string QuoteHint = "Say something about this post";

    /// <summary> Marks the button that removes one of the reader's own posts. </summary>
    const string DeleteEmoji = "🗑️";

    /// <summary> Marks the button that reports somebody else's post. </summary>
    const string ReportEmoji = "🚩";

    /// <summary> Marks the badge shown when the post's signature does not verify. </summary>
    const string UnverifiedEmoji = "⚠️";

    /// <summary> Badge text shown when the post's signature does not verify against its author's published key. </summary>
    const string UnverifiedLabel = "unverified signature";

    /// <summary> Class appended to the like button while the post is liked; it carries the filled-heart colours. </summary>
    const string LikedModifierClass = "is-liked";

    /// <summary> Tooltip on the author button. </summary>
    const string OpenAuthorHint = "Open this profile";

    /// <summary> Tooltip on the chay button before one has been given. </summary>
    const string LikeHint = "Chay it!";

    /// <summary> Tooltip on it afterwards. </summary>
    const string UnlikeHint = "Take your chay back";

    /// <summary> Tooltip on the comment button. </summary>
    const string CommentsHint = "Read and write comments";

    /// <summary> Tooltip on the delete button. </summary>
    const string DeleteHint = "Delete this post";

    /// <summary> Tooltip on the report button. </summary>
    const string ReportHint = "Report this post";

    /// <summary> Characters kept from the start of an address before the ellipsis; enough to include the "chay" label. </summary>
    const int AddressLeadingCharacterCount = 10;

    /// <summary> Characters kept from the end of an address after the ellipsis. </summary>
    const int AddressTrailingCharacterCount = 4;

    /// <summary> Placed between the two kept halves of a shortened address. </summary>
    const string AddressEllipsis = "…";

    /// <summary> The post being drawn. </summary>
    [Parameter, EditorRequired] public PostData Post { get; set; } = default!;

    /// <summary> Profile of the post's author, or null while it has not been read; the card falls back to address-derived values. </summary>
    [Parameter] public ProfileData? AuthorProfile { get; set; }

    /// <summary> True when the signed-in account has already liked this post, which fills the heart. </summary>
    [Parameter] public bool IsLiked { get; set; }

    /// <summary> How many accounts liked this post. </summary>
    [Parameter] public int LikeCount { get; set; }

    /// <summary> How many comments this post carries. </summary>
    [Parameter] public int CommentCount { get; set; }

    /// <summary> Raised when the reader taps the heart; the page decides whether that adds or removes the like. </summary>
    [Parameter] public EventCallback OnLike { get; set; }

    /// <summary> Raised when the author taps delete on their own post. </summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary> Raised when the reader reports somebody else's post. </summary>
    [Parameter] public EventCallback OnReport { get; set; }

    /// <summary> Raised when the reader taps the avatar or name to open the author's profile. </summary>
    [Parameter] public EventCallback OnOpenAuthor { get; set; }

    /// <summary> Raised when the reader taps the comment count to open the post's comments. </summary>
    [Parameter] public EventCallback OnOpenComments { get; set; }

    /// <summary> Raised when the reader wants to quote this post. The action only appears when a caller wires this up. </summary>
    [Parameter] public EventCallback OnQuote { get; set; }

    /// <summary> True when the signed-in account has already carried this post onto its own wall. </summary>
    [Parameter] public bool IsReposted { get; set; }

    /// <summary> How many accounts carried this post onto their own wall. </summary>
    [Parameter] public int RepostCount { get; set; }

    /// <summary> Raised when the reader taps the repost action. The action only appears when a caller wires this up. </summary>
    [Parameter] public EventCallback OnRepost { get; set; }

    /// <summary> Name of the account whose wall carried this post into the feed, or null when it arrived on its own. </summary>
    [Parameter] public string? RepostedByName { get; set; }

    /// <summary> Raised when the reader taps that name, to open the wall it came through. </summary>
    [Parameter] public EventCallback OnOpenReposter { get; set; }

    /// <summary> The post this one quotes, already read by the page; null when it was deleted or this post quotes nothing. </summary>
    [Parameter] public PostData? QuotedPost { get; set; }

    /// <summary> Profile of the quoted post's author, or null when it could not be read. </summary>
    [Parameter] public ProfileData? QuotedAuthorProfile { get; set; }

    /// <summary> Raised when the reader taps the quoted post, to open the original. </summary>
    [Parameter] public EventCallback OnOpenQuoted { get; set; }

    /// <summary> Hands the quote request to the page, which owns the composer it lands in. </summary>
    /// <returns> A task that completes once the page has handled it. </returns>
    Task HandleQuote() => OnQuote.InvokeAsync();

    /// <summary> Result of the last signature check, kept between renders so verifying does not run on every repaint. </summary>
    bool IsSignatureTrusted;

    /// <summary>
    /// Re-runs the signature check whenever the post or its author profile changes, so the verdict the card draws
    /// always belongs to the post currently on screen.
    /// </summary>
    protected override void OnParametersSet()
    {
        IsSignatureTrusted = Post is not null && WallService.VerifyAuthorship(Post, AuthorProfile);

        // Checked here rather than at every repaint, and only against a profile the card was actually handed:
        // a payment address is worth exactly as much as the signature over it.
        CanBeTipped = !IsOwnPost && ProfileService.VerifyTipAddress(AuthorProfile);
    }

    /// <summary> True when the signed-in account wrote this post, which swaps the report button for a delete button. </summary>
    bool IsOwnPost => Post is not null && SessionService.IsSignedIn && Post.AuthorAddress == SessionService.CurrentAddress;

    /// <summary> True when the delete button belongs on this card: the reader wrote the post and the page handles removal. </summary>
    bool ShowDeleteAction => IsOwnPost && OnDelete.HasDelegate;

    /// <summary> True when the report button belongs on this card: somebody else wrote the post and the page handles reports. </summary>
    bool ShowReportAction => !IsOwnPost && SessionService.IsSignedIn && OnReport.HasDelegate;

    /// <summary> Emoji drawn in the avatar bubble: the author's own pick, or the one their address maps to. </summary>
    string AvatarEmoji => string.IsNullOrEmpty(AuthorProfile?.Avatar)
        ? ProfileService.PickAvatar(Post.AuthorAddress)
        : AuthorProfile.Avatar;

    /// <summary> Name drawn next to the avatar: the author's chosen name, or the readable head of their address. </summary>
    string DisplayName => string.IsNullOrWhiteSpace(AuthorProfile?.DisplayName)
        ? ProfileService.FallbackDisplayName(Post.AuthorAddress)
        : AuthorProfile.DisplayName;

    /// <summary>
    /// The chay count as it is read: a bare zero would put "0 chays" under every new post, which reads as a
    /// verdict rather than a count, so nothing is said until somebody has poured one.
    /// </summary>
    string ChayCountLabel => LikeCount switch
    {
        0 => string.Empty,
        1 => $"{LikeCount} {SingleChayWord}",
        _ => $"{LikeCount} {ManyChaysWord}"
    };

    /// <summary> How long ago the post was published, in the short form the whole app uses. </summary>
    string RelativeTime => RelativeTimeFormatter.Format(Post.CreatedAtUnixMs);

    /// <summary> Full publication time, shown when the reader hovers the short relative label. </summary>
    string PublishedAtHint => RelativeTimeFormatter.FormatExact(Post.CreatedAtUnixMs);

    /// <summary> Hairline that outlines the unverified-signature badge in the warning colour. </summary>
    string UnverifiedChipBorder => $"{AppMeasures.Border.Thin}px solid {AppColors.Warning.ToRgbaHex(true)}";

    /// <summary>
    /// The author's address with its middle replaced by an ellipsis, so a full-length address still fits one line on
    /// a phone. Addresses too short to gain anything from the cut are drawn whole.
    /// </summary>
    string ShortenedAddress
    {
        get
        {
            string address = Post.AuthorAddress;
            int keptCharacterCount = AddressLeadingCharacterCount + AddressTrailingCharacterCount;

            return address.Length <= keptCharacterCount + AddressEllipsis.Length
                ? address
                : string.Concat(
                    address.AsSpan(0, AddressLeadingCharacterCount),
                    AddressEllipsis,
                    address.AsSpan(address.Length - AddressTrailingCharacterCount));
        }
    }

    /// <summary> Passes the heart tap to the page, doing nothing when the page wired no handler. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleLike() => OnLike.HasDelegate ? OnLike.InvokeAsync() : Task.CompletedTask;

    /// <summary> Passes the delete tap to the page, doing nothing when the page wired no handler. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleDelete() => OnDelete.HasDelegate ? OnDelete.InvokeAsync() : Task.CompletedTask;

    /// <summary> Passes the report tap to the page, doing nothing when the page wired no handler. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleReport() => OnReport.HasDelegate ? OnReport.InvokeAsync() : Task.CompletedTask;

    /// <summary> Passes the author tap to the page, doing nothing when the page wired no handler. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleOpenAuthor() => OnOpenAuthor.HasDelegate ? OnOpenAuthor.InvokeAsync() : Task.CompletedTask;

    /// <summary> Passes the comment tap to the page, doing nothing when the page wired no handler. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleOpenComments() => OnOpenComments.HasDelegate ? OnOpenComments.InvokeAsync() : Task.CompletedTask;

    /// <summary> Passes the repost tap to the page, which decides whether that adds or removes the repost. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleRepost() => OnRepost.HasDelegate ? OnRepost.InvokeAsync() : Task.CompletedTask;

    /// <summary> Passes a tap on the reposter's name to the page, doing nothing when the page wired no handler. </summary>
    /// <returns> A task that completes once the page has handled the tap. </returns>
    Task HandleOpenReposter() => OnOpenReposter.HasDelegate ? OnOpenReposter.InvokeAsync() : Task.CompletedTask;
}
