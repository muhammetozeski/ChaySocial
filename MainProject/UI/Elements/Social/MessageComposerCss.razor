@*
    Styling for MessageComposer. MessageComposer renders this component itself, so the composer always
    arrives with its own CSS attached.
*@
@{
    const int VanishSwitchDiameterPx = 34;
    const float VanishSwitchGlowOpacity = 0.3f;
    const int ReplyBarPaddingYPx = 8;
    const int ReplyBarPaddingXPx = 14;
    const int ReplyBarGapPx = 8;
    const int ReplyDropDiameterPx = 20;
}

<style>
    /* Sits directly above the composer and shares its rounded top, so the two read as one control: what is being
       replied to, and the box the reply is written in. */
    .message-composer-reply {
        display: flex;
        align-items: center;
        gap: @(ReplyBarGapPx)px;
        width: @(AppMeasures.Percent.Full)%;
        box-sizing: border-box;
        padding: @(ReplyBarPaddingYPx)px @(ReplyBarPaddingXPx)px;
        margin-bottom: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        animation: message-composer-reply-arrive @(AppMeasures.Duration.Fast)s ease both;
    }

    .message-composer-reply-mark {
        flex: none;
        color: @(AppColors.Primary.ToRgbaHex(true));
    }

    .message-composer-reply-text {
        flex: 1;
        min-width: 0;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .message-composer-reply-drop {
        flex: none;
        width: @(ReplyDropDiameterPx)px;
        height: @(ReplyDropDiameterPx)px;
        display: grid;
        place-items: center;
        padding: 0;
        border: none;
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: transparent;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        transition: color @(AppMeasures.Duration.Fast)s ease;
    }

        .message-composer-reply-drop:hover {
            color: @(AppColors.TextDanger.ToRgbaHex(true));
        }

    @@keyframes message-composer-reply-arrive {
        from {
            opacity: 0;
            transform: translateY(@(AppMeasures.Space.Px6)px);
        }
    }
</style>

<style>
    .message-composer {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px16)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        box-sizing: border-box;
    }

    /* min-width:0 lets the field shrink inside the flex row instead of pushing the send button out of the pill. */
    /* The read-once switch. Off it is a quiet outline; on it fills amber, because a message that destroys
       itself is worth seeing before the send button is pressed rather than after. */
    .message-composer-vanish {
        flex: 0 0 auto;
        width: @(VanishSwitchDiameterPx)px;
        height: @(VanishSwitchDiameterPx)px;
        display: grid;
        place-items: center;
        padding: 0;
        border-radius: @(AppMeasures.Radius.Circular)%;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        background: transparent;
        font-size: @(AppMeasures.Font.Normal)px;
        cursor: pointer;
        opacity: @(AppMeasures.Opacity.Dim);
        transition: opacity @(AppMeasures.Duration.Fast)s ease, border-color @(AppMeasures.Duration.Fast)s ease, background @(AppMeasures.Duration.Fast)s ease;
    }

        .message-composer-vanish:hover:not(:disabled) {
            opacity: 1;
        }

    .message-composer-vanish--on {
        opacity: 1;
        border-color: @(AppColors.Accent.ToRgbaHex(true));
        background: @(AppColors.SurfaceTintAccent.ToRgbaHex(true));
        box-shadow: @(AppStyles.GetGlow(AppColors.Accent, VanishSwitchGlowOpacity));
    }

    .message-composer-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        padding: @(AppMeasures.Space.Px10)px 0;
        font-family: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

        .message-composer-input::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
        }

        .message-composer-input:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
        }

    /* Sizes the CoreButton that sends; CoreButton owns its own press and disabled behaviour. */
    .message-composer-send {
        flex-shrink: 0;
        width: @(SendButtonDiameterPx)px;
        height: @(SendButtonDiameterPx)px;
    }

    .message-composer-send-emoji {
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
    }
</style>

@code {
    /// <summary> Side of the round send button. Wide enough to stay an easy thumb target at the bottom of a conversation. </summary>
    const int SendButtonDiameterPx = AppMeasures.Size.Px44;
}
