@* Styles for PostCard. Every selector is namespaced "post-card-*" because *Css.razor styles are global
   (this project uses no CSS isolation), so bare names would leak into every other component. All colours,
   sizes and timings come from C# tokens so a theme swap restyles the card on the next render. *@
<style>
    .post-card {
        gap: @(AppMeasures.Space.Px12)px;
        animation: post-card-rise @(AppMeasures.Duration.Normal)s @SoftLandingEasing both;
    }

    .post-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px8)px;
    }

    /* The avatar and name together are one tap target that opens the author, so the wrapper is a real
       button stripped back to plain text styling. */
    .post-card-identity {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        flex: 1 1 auto;
        min-width: 0;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        color: inherit;
        text-align: left;
        cursor: pointer;
    }

    .post-card-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        /* The author's mark is laid inside this disc absolutely, so the disc has to be what it is measured against
           and the square grid has to be trimmed back to the circle. */
        position: relative;
        overflow: hidden;
        width: @(AppMeasures.Size.Px44)px;
        height: @(AppMeasures.Size.Px44)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        font-size: @(AppMeasures.Font.Large)px;
        line-height: @(AppMeasures.LineHeight.None);
        background: linear-gradient(@(AvatarGradientAngleDegrees)deg, @(AppColors.Primary.ToRgbaHex(true)), @(AppColors.Secondary.ToRgbaHex(true)));
        box-shadow: @AppStyles.ShadowPrimaryGlow;
        transition: transform @(AppMeasures.Duration.Fast)s @SoftLandingEasing;
    }

        /* The emoji, lifted above the mark. Without a position of its own the positioned mark would paint over it. */
        .post-card-avatar-face {
            position: relative;
            z-index: @(AppMeasures.ZLayer.Raised);
        }

    .post-card-identity:active .post-card-avatar {
        transform: scale(@AvatarPressedScale);
    }

    /* min-width:0 lets the two labels below actually shrink, which is what makes their ellipsis work. */
    .post-card-identity-text {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        min-width: 0;
    }

    .post-card-name {
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .post-card-address {
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.XSmall)px;
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
    }

    .post-card-name,
    .post-card-address {
        display: block;
        max-width: @(AppMeasures.Percent.Full)%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .post-card-time {
        flex-shrink: 0;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
        white-space: nowrap;
    }

    /* Holds the unverified badge on its own line and keeps it hugging its text instead of stretching
       across the card the way a lone inline-flex child of a column would. */
    .post-card-badge-row {
        display: flex;
        align-items: center;
    }

    .post-card-text {
        margin: 0;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* The title of a long piece: the loudest thing on the card, because on a card carrying an essay it is what a
       reader is actually choosing between. */
    .post-card-title {
        margin: 0;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(PostTitleFontSizePx)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Snug);
        overflow-wrap: anywhere;
    }

    .post-card-read-on {
        align-self: flex-start;
        padding: 0;
        border: none;
        background: transparent;
        color: @(AppColors.Primary.ToRgbaHex(true));
        cursor: pointer;
        font-family: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Medium);
    }

        .post-card-read-on:hover {
            text-decoration: underline;
        }

    .post-card-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .post-card-action {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Medium);
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s @SoftLandingEasing, background @(AppMeasures.Duration.Fast)s, color @(AppMeasures.Duration.Fast)s, border-color @(AppMeasures.Duration.Fast)s;
    }

    .post-card-action:active {
        transform: scale(@ActionPressedScale);
    }

    .post-card-action-icon {
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .post-card-action-count {
        font-variant-numeric: tabular-nums;
    }

    .post-card-action--like.is-liked {
        background: @(AppColors.SurfaceTintAccent.ToRgbaHex(true));
        border-color: @(AppColors.Secondary.ToRgbaHex(true));
        color: @(AppColors.TextWarning.ToRgbaHex(true));
    }

    /* The glass is only poured on the render where this class appears, which is the moment the chay is given.
       position:relative is what the steam above it is positioned against. */
    .post-card-action--like.is-liked .post-card-action-icon {
        position: relative;
        animation: post-card-chay-pour @(AppMeasures.Duration.Medium)s @PlayfulOvershootEasing;
    }

    /* A curl of steam that rises off the glass once and fades. It is drawn by the icon itself rather than by an
       element of its own, so nothing is added to the card for a moment of animation. */
    .post-card-action--like.is-liked .post-card-action-icon::after {
        content: "@SteamGlyph";
        position: absolute;
        left: @(AppMeasures.Percent.Half)%;
        bottom: @(AppMeasures.Percent.Full)%;
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: @(AppMeasures.LineHeight.None);
        pointer-events: none;
        opacity: 0;
        animation: post-card-chay-steam @(AppMeasures.Duration.Slow)s ease-out;
    }

    /* The teapot warms under the pointer rather than sitting lit: offering to pay somebody should read as an
       invitation, not as a demand. */
    .post-card-action--tip:hover {
        border-color: @(AppColors.Gold.ToRgbaHex(true));
        color: @(AppColors.Gold.ToRgbaHex(true));
    }

    .post-card-tip {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: @(AppMeasures.Space.Px12)px;
        text-align: center;
    }

    .post-card-tip-emoji {
        font-size: @(AppMeasures.Font.Giant)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .post-card-tip-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Tight);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    .post-card-tip-text,
    .post-card-tip-note {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .post-card-tip-note {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .post-card-tip-chain {
        align-self: center;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.Gold.ToRgbaHex(true));
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.Gold.ToRgbaHex(true));
    }

    /* Monospaced and selectable: the reader copies this into their own wallet, and every character matters. */
    .post-card-tip-address {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px12)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font-family: @MonospaceStack;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        text-align: center;
        outline: none;
    }

    .post-card-action--danger {
        color: @(AppColors.TextDanger.ToRgbaHex(true));
    }

    /* Pushes the delete / report button to the far edge, away from the like and comment counts. */
    .post-card-action--trailing {
        margin-left: auto;
    }

    .post-card-action--repost.is-reposted {
        background: @(AppColors.SurfaceTintAccent.ToRgbaHex(true));
        border-color: @(AppColors.Primary.ToRgbaHex(true));
        color: @(AppColors.PrimaryLight.ToRgbaHex(true));
    }

    /* The arrows turn once, on the render where the post lands on the reader's wall. */
    .post-card-action--repost.is-reposted .post-card-action-icon {
        animation: post-card-repost-turn @(AppMeasures.Duration.Medium)s @PlayfulOvershootEasing;
    }

    /* A quiet line above the post, stripped back from a button to plain text: it names the wall this post came
       through without competing with the author underneath it. */
    .post-card-carried {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        align-self: flex-start;
        max-width: @(AppMeasures.Percent.Full)%;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        text-align: left;
        cursor: pointer;
    }

    .post-card-carried:hover {
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .post-card-carried-icon {
        flex: none;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .post-card-carried-text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @@keyframes post-card-rise {
        from {
            opacity: 0;
            transform: translateY(@(AppMeasures.Space.Px8)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes post-card-chay-pour {
        0% {
            transform: scale(1) rotate(0deg);
        }

        @(PourTiltStopPercent)% {
            transform: scale(@PourPeakScale) rotate(-@(PourTiltDegrees)deg);
        }

        @(AppMeasures.Percent.Full)% {
            transform: scale(1) rotate(0deg);
        }
    }

    @@keyframes post-card-chay-steam {
        0% {
            opacity: 0;
            transform: translate(-@(AppMeasures.Percent.Half)%, 0) scale(@SteamStartScale);
        }

        @(SteamPeakPercent)% {
            opacity: 1;
        }

        @(AppMeasures.Percent.Full)% {
            opacity: 0;
            transform: translate(-@(AppMeasures.Percent.Half)%, -@(SteamRisePx)px) scale(1);
        }
    }

    @@keyframes post-card-repost-turn {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(@(RepostTurnDegrees)deg);
        }
    }

    /* Phone width: the card keeps every control, it only gives back the padding it can spare. */
    @@media (max-width: @(NarrowScreenBreakpointPx)px) {
        .post-card-avatar {
            width: @(AppMeasures.Size.Px40)px;
            height: @(AppMeasures.Size.Px40)px;
        }

        .post-card-action {
            padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px;
        }

        .post-card-text {
            font-size: @(AppMeasures.Font.Normal)px;
        }
    }
</style>

@code {
    /// <summary> Size of a long piece's title on a card: above the post text under it, below the page heading. </summary>
    const int PostTitleFontSizePx = AppMeasures.Font.Large;

    /// <summary> Angle of the avatar bubble's two-colour sheen, matching the diagonal every other gradient surface uses. </summary>
    const int AvatarGradientAngleDegrees = 135;

    /// <summary> How far the avatar bubble shrinks while the author button is held down. </summary>
    const string AvatarPressedScale = "0.94";

    /// <summary> How far an action pill shrinks while it is held down. </summary>
    const string ActionPressedScale = "0.94";

    /// <summary> How far the glass swells as the chay is poured, before settling back. </summary>
    const string PourPeakScale = "1.3";

    /// <summary> How far the glass tips as it is poured. </summary>
    const int PourTiltDegrees = 12;

    /// <summary> Where in the pour the tilt reaches its furthest, as a percentage of the animation. </summary>
    const int PourTiltStopPercent = 50;

    /// <summary> The curl of steam that rises off a poured glass. </summary>
    const string SteamGlyph = "♨";

    /// <summary> How far the steam rises before it is gone. </summary>
    const int SteamRisePx = AppMeasures.Space.Px12;

    /// <summary> How small the steam starts before it grows on its way up. A string so the decimal survives any OS culture. </summary>
    const string SteamStartScale = "0.6";

    /// <summary> Where in its rise the steam is at full strength, as a percentage of the animation. </summary>
    const int SteamPeakPercent = 30;

    /// <summary> How far the repost arrows turn as the post lands on the reader's wall — one full revolution. </summary>
    const int RepostTurnDegrees = 360;

    /// <summary> Easing that starts fast and settles softly, used for entrances and presses. </summary>
    const string SoftLandingEasing = "cubic-bezier(0.16, 1, 0.3, 1)";

    /// <summary> Fixed-width faces for a payment address, where a mistaken character costs money. </summary>
    const string MonospaceStack = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";

    /// <summary> Easing that overshoots past its target before coming back, which is what makes the heart pop read as playful. </summary>
    const string PlayfulOvershootEasing = "cubic-bezier(0.34, 1.56, 0.64, 1)";

    /// <summary> Widest viewport still treated as a phone, below which the card tightens its spacing. </summary>
    const int NarrowScreenBreakpointPx = AppMeasures.Size.Px420;
}
