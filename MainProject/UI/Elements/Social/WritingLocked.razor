@using ChaySocial.MainProject.Protection
@using ChaySocial.MainProject.Services
@inject NavigationManager NavManager

@*
    Stands where a composer would, for an account that has not earned its writing permit. It is drawn instead of
    the composer rather than beside it, so nobody types a paragraph and only then finds out it will be refused.

    Every screen that can write uses this one component, so the offer reads the same wherever somebody meets it.
*@

<div class="writing-locked" style="@SurfaceStyle">
    <span class="writing-locked-emoji">@Emoji</span>

    <div class="writing-locked-text">
        <span class="writing-locked-headline">@(IsOffline ? OfflineHeadline : Headline)</span>
        <span class="writing-locked-description">@(IsOffline ? OfflineDescription : Description)</span>
    </div>

    @if (!IsOffline)
    {
        <CoreButton OnClick="OpenSettings"
                    Gradient="@((AppColors.Primary, AppColors.Secondary))"
                    TextColor="@AppColors.TextOnAccent"
                    BorderRadius="@(AppMeasures.Radius.Pill + "px")"
                    Padding="@ActionPadding"
                    FontSize="@AppMeasures.Font.Small"
                    Shadow="@AppStyles.ShadowPrimaryGlow"
                    CustomClass="writing-locked-action">
            @ActionLabel
        </CoreButton>
    }
</div>

<WritingLockedCss />

@code {
    /// <summary>
    /// True when a composer must not be offered: either the account still owes its permit, or the app is reading a
    /// sealed file and there is nothing anywhere to write to.
    /// </summary>
    /// <remarks>
    /// The offline half is not decoration. Reading an archive leaves the proof of work unwired, so the permit test
    /// on its own comes back false and every composer in the app would offer to write into a sealed file.
    /// </remarks>
    public static bool IsLocked => OfflineReadingService.IsReading || AppServices.ProofOfWork is { HasWritingPermit: false };

    /// <summary> True while what is on screen came out of a file rather than a server. </summary>
    static bool IsOffline => OfflineReadingService.IsReading;

    /// <summary> Emoji beside the offer. </summary>
    string Emoji => IsOffline ? OfflineEmoji : PermitEmoji;

    /// <summary> Marks the permit offer. </summary>
    const string PermitEmoji = "✍️";

    /// <summary> Marks the offline notice: a box holding what was written, with nothing to send it to. </summary>
    const string OfflineEmoji = "📦";

    /// <summary> First line while a file is being read. </summary>
    const string OfflineHeadline = "You are reading a file";

    /// <summary> Second line: why there is nothing to write with. </summary>
    const string OfflineDescription = "Nothing is being talked to, so there is nowhere for a new post to go. Everything here is what you sealed.";

    /// <summary> First line: what the state is. </summary>
    const string Headline = "Writing is earned once";

    /// <summary> Second line: what it costs and what it buys. </summary>
    const string Description = "A few minutes of this device's time, once. After that everything you write goes out instantly.";

    /// <summary> Label on the button that leads to where it is earned. </summary>
    const string ActionLabel = "Earn it";

    /// <summary> Where that button leads. </summary>
    const string SettingsRoute = "/settings";

    /// <summary> Inside spacing of that button. </summary>
    static readonly string ActionPadding = $"{AppMeasures.Space.Px8}px {AppMeasures.Space.Px16}px";

    /// <summary> The frosted ground this sits on, the same glass a composer uses. </summary>
    string SurfaceStyle => AppStyles.BuildAcrylicStyle(AcrylicLevel.Subtle, AppMeasures.Blur.Subtle);

    /// <summary> Opens the screen where the permit is earned. </summary>
    void OpenSettings() => NavManager.NavigateTo(SettingsRoute);
}
