@*
    Styling for CommentComposer. CommentComposer renders this component itself, so the composer always
    arrives with its own CSS attached.
*@
<style>
    .comment-composer {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px14)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        box-sizing: border-box;
    }

    /* Sits above the pill and names who is being answered, so the writer can see it without looking away from
       where they are typing. */
    .comment-composer-answering {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        width: @(AppMeasures.Percent.Full)%;
        margin-bottom: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px14)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        box-sizing: border-box;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .comment-composer-answering-mark {
        flex: none;
        color: @(AppColors.PrimaryLight.ToRgbaHex(true));
    }

    .comment-composer-answering-text {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .comment-composer-answering-drop {
        flex: none;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        cursor: pointer;
    }

        .comment-composer-answering-drop:hover:not(:disabled) {
            color: @(AppColors.TextDanger.ToRgbaHex(true));
        }

    .comment-composer-badge {
        flex-shrink: 0;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
        opacity: @(AppMeasures.Opacity.Muted);
    }

    /* min-width:0 lets the field shrink inside the flex row instead of pushing the hint out of the pill. */
    .comment-composer-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        padding: @(AppMeasures.Space.Px10)px 0;
        font-family: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

        .comment-composer-input::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
        }

        .comment-composer-input:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
        }

    /* The send disc: dim while there is nothing to send, lit in primary the moment there is. Its native button
       styling is stripped back first, the way every other control in the app is built. */
    .comment-composer-send {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: @(SendDiameterPx)px;
        height: @(SendDiameterPx)px;
        padding: 0;
        border: none;
        border-radius: @(AppMeasures.Radius.Circular)%;
        font: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.None);
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        cursor: pointer;
        transition: color @(AppMeasures.Duration.Fast)s, background @(AppMeasures.Duration.Fast)s, transform @(AppMeasures.Duration.Fast)s;
    }

        .comment-composer-send:disabled {
            cursor: default;
        }

        .comment-composer-send--ready {
            color: @(AppColors.TextOnFilledSurface.ToRgbaHex(true));
            background: @(AppColors.Primary.ToRgbaHex(true));
            transform: scale(@ReadySendScale);
        }

        .comment-composer-send--ready:active {
            transform: scale(@PressedSendScale);
        }
</style>

@code {
    /// <summary> Side of the round send disc sitting at the end of the pill. </summary>
    const int SendDiameterPx = AppMeasures.Size.Px24;

    /// <summary> How much the send disc swells once the text is sendable. A string so the decimal point survives any OS culture. </summary>
    const string ReadySendScale = "1.1";

    /// <summary> How far it shrinks while held down, so a tap answers before the reply has finished going out. </summary>
    const string PressedSendScale = "0.95";
}
