@*
    Styling for a long piece. Reading is the whole point of this component, so the measurements here are the ones
    that decide whether a page of text is comfortable: the space between blocks, the line height, and how far a
    quote stands out of the column.
*@
<style>
    .prose-view {
        display: flex;
        flex-direction: column;
        gap: @(ProseBlockGapPx)px;
    }

    /* Every block is a row: the margin on the left where a note can be left, the words on the right. Where nobody
       is taking notes the margin is not drawn at all, so a card in a feed lays out exactly as it always did. */
    .prose-view-block {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
    }

        .prose-view-block.is-chosen {
            background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
            box-shadow: 0 0 0 @(ChosenBlockOutlinePx)px @(AppColors.Primary.ToRgbaHex(true));
        }

    .prose-view-margin {
        flex-shrink: 0;
        width: @(ProseMarginWidthPx)px;
    }

    .prose-view-body {
        flex: 1;
        min-width: 0;
    }

    /* Quiet until it is wanted: a mark this size beside every paragraph would compete with the words it belongs to. */
    .prose-view-note-button {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
        width: @(ProseMarginWidthPx)px;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        line-height: @(AppMeasures.LineHeight.None);
        opacity: @(RestingMarkOpacity);
        cursor: pointer;
    }

        .prose-view-note-button:hover,
        .prose-view-block.is-chosen .prose-view-note-button {
            opacity: @(WantedMarkOpacity);
        }

    .prose-view-note-mark {
        font-size: @(ProseNoteMarkFontSizePx)px;
    }

    .prose-view-note-count {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.Primary.ToRgbaHex(true));
    }

    .prose-view-paragraph {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .prose-view-heading {
        margin: 0;
        font-size: @(ProseHeadingFontSizePx)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    /* A bar down the side rather than quotation marks: the words inside are somebody else's, and a reader should
       see that before they read them rather than after. */
    .prose-view-quote {
        margin: 0;
        padding-left: @(AppMeasures.Space.Px12)px;
        border-left: @(ProseQuoteBarWidthPx)px solid @(AppColors.Primary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .prose-view-bullet {
        display: flex;
        gap: @(AppMeasures.Space.Px8)px;
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .prose-view-bullet-mark {
        flex-shrink: 0;
        color: @(AppColors.Primary.ToRgbaHex(true));
    }

    .prose-view-bullet-text {
        min-width: 0;
        overflow-wrap: anywhere;
    }
</style>

@code {
    /// <summary> Space between one block and the next: what turns a wall of lines into paragraphs. </summary>
    const int ProseBlockGapPx = AppMeasures.Space.Px12;

    /// <summary> Size of a heading inside a piece — above the prose around it, below the post's own title. </summary>
    const int ProseHeadingFontSizePx = AppMeasures.Font.Large;

    /// <summary> Thickness of the bar down the side of a quoted line. </summary>
    const int ProseQuoteBarWidthPx = AppMeasures.Border.Medium;

    /// <summary> Width of the column the note mark sits in, left of the words. </summary>
    const int ProseMarginWidthPx = AppMeasures.Size.Px24;

    /// <summary> Size of the mark itself: readable at a glance, smaller than the prose it stands beside. </summary>
    const int ProseNoteMarkFontSizePx = AppMeasures.Font.Small;

    /// <summary> Thickness of the ring drawn around the block the reader picked. </summary>
    const int ChosenBlockOutlinePx = AppMeasures.Border.Thin;

    /// <summary> How visible a note mark is before it is hovered or picked: present, but not competing with the words. </summary>
    const string RestingMarkOpacity = AppMeasures.Opacity.Dim;

    /// <summary> And once it is hovered or picked, which is the only time it is being looked at. </summary>
    const string WantedMarkOpacity = "1";
}
