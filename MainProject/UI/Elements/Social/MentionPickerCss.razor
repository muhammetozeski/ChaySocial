@*
    Styling for MentionPicker. MentionPicker renders this component itself, so the picker always arrives with its
    own CSS attached. Every selector is namespaced "mention-picker-*" because *Css.razor styles are global.
*@
<style>
    /* The button that opens the sheet: a quiet disc carrying the same mark a name is written with, sized to match
       the other controls sitting along a composer. */
    .mention-picker-open {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: @(OpenButtonDiameterPx)px;
        height: @(OpenButtonDiameterPx)px;
        padding: 0;
        border: none;
        border-radius: @(AppMeasures.Radius.Circular)%;
        font: inherit;
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.None);
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        cursor: pointer;
        transition: color @(AppMeasures.Duration.Fast)s, background @(AppMeasures.Duration.Fast)s;
    }

        .mention-picker-open:hover:not(:disabled) {
            color: @(AppColors.PrimaryLight.ToRgbaHex(true));
            background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
        }

        .mention-picker-open:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: default;
        }

    .mention-picker {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: @(AppMeasures.Space.Px12)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(SheetMaximumWidthPx)px;
        text-align: left;
    }

    .mention-picker-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Tight);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .mention-picker-subtitle {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .mention-picker-field {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px14)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Pill)px;
        font: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        outline: none;
    }

        .mention-picker-field:focus {
            border-color: @(AppColors.Primary.ToRgbaHex(true));
        }

    .mention-picker-status {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: @(AppMeasures.Space.Px16)px 0;
    }

    .mention-picker-status-text {
        margin: 0;
        padding: @(AppMeasures.Space.Px12)px 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    /* The results scroll inside the sheet rather than growing it past the screen. */
    .mention-picker-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px6)px;
        max-height: @(ListMaximumHeightPx)px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: @(AppColors.BorderStrong.ToRgbaHex(true)) transparent;
    }

    /* Each result is a real button, so a keyboard names somebody exactly as a tap does. */
    .mention-picker-row {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border: @(AppMeasures.Border.Thin)px solid transparent;
        border-radius: @(AppMeasures.Radius.Large)px;
        font: inherit;
        color: inherit;
        text-align: left;
        background: none;
        cursor: pointer;
        transition: background @(AppMeasures.Duration.Fast)s, border-color @(AppMeasures.Duration.Fast)s;
    }

        .mention-picker-row:hover {
            background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
            border-color: @(AppColors.BorderSoft.ToRgbaHex(true));
        }

    /* min-width:0 lets a long address wrap inside the row instead of widening the sheet. */
    .mention-picker-row-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px2)px;
        flex: 1;
        min-width: 0;
    }

    .mention-picker-row-name {
        min-width: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }
</style>

@code {
    /// <summary> Side of the round button that opens the sheet, matching the other controls along a composer. </summary>
    const int OpenButtonDiameterPx = AppMeasures.Size.Px36;

    /// <summary> Widest the sheet grows on a large screen. </summary>
    const int SheetMaximumWidthPx = 420;

    /// <summary> Tallest the result list grows before it scrolls inside the sheet. </summary>
    const int ListMaximumHeightPx = 320;
}
