@using ChaySocial.MainProject.DataModels
@using ChaySocial.MainProject.Text

@*
    Single-line composer for replying under a post: a frosted pill holding one text field and, at its end, the
    disc that sends. The return key sends too, and the disc lights up in primary the moment there is something
    worth sending — but it is a real button, because a phone has no return key beside the thumb on the screen.
*@
@if (AnsweringName is not null)
{
    <div class="comment-composer-answering" style="@SurfaceStyle">
        <span class="comment-composer-answering-mark">@AnsweringMark</span>
        <span class="comment-composer-answering-text">@AnsweringLabel @AnsweringName</span>
        <button type="button"
                class="comment-composer-answering-drop"
                title="@DropAnswerHint"
                disabled="@IsBusy"
                @onclick="OnCancelAnswer">@DropAnswerMark</button>
    </div>
}

<div class="comment-composer" style="@SurfaceStyle">
    <span class="comment-composer-badge">@ComposerEmoji</span>

    <input class="comment-composer-input"
           type="text"
           placeholder="@Placeholder"
           maxlength="@CommentData.MaximumTextLength"
           value="@Text"
           disabled="@IsBusy"
           @oninput="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync" />

    <MentionPicker OnPick="NameSomebodyAsync" IsDisabled="@IsBusy" />

    @if (IsBusy)
    {
        <CoreSpinner SizePx="@BusySpinnerDiameterPx" BorderWidthPx="@BusySpinnerBorderPx" Color="@AppColors.Primary" />
    }
    else
    {
        <button type="button"
                class="comment-composer-send @ReadyHintModifier"
                title="@SendHint"
                disabled="@(!CanSubmit)"
                @onclick="HandleSendAsync">@ReturnKeyGlyph</button>
    }
</div>

<CommentComposerCss />

@code {
    /// <summary> What the author has typed so far. </summary>
    [Parameter] public string Text { get; set; } = string.Empty;

    /// <summary> Raised on every keystroke with the field's new contents, so the caller owns the text. </summary>
    [Parameter] public EventCallback<string> TextChanged { get; set; }

    /// <summary> Raised when the author presses return on text worth sending. Publishing the reply belongs to the caller. </summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    /// <summary> True while the caller is publishing the reply: the field locks and the return-key disc becomes a spinner. </summary>
    [Parameter] public bool IsBusy { get; set; }

    /// <summary> Grey prompt shown in the empty field. </summary>
    [Parameter] public string Placeholder { get; set; } = DefaultPlaceholder;

    /// <summary> Name of the account being answered, or null while the reply speaks to the post itself. </summary>
    [Parameter] public string? AnsweringName { get; set; }

    /// <summary> Raised when the author drops the answer and goes back to replying to the post. </summary>
    [Parameter] public EventCallback OnCancelAnswer { get; set; }

    /// <summary> Prompt used when the caller does not supply one. </summary>
    const string DefaultPlaceholder = "Say something kind…";

    /// <summary> Mark before the name of whoever is being answered. </summary>
    const string AnsweringMark = "↩";

    /// <summary> Leads that name. </summary>
    const string AnsweringLabel = "Answering";

    /// <summary> Mark on the control that drops the answer. </summary>
    const string DropAnswerMark = "✕";

    /// <summary> Tooltip on that control. </summary>
    const string DropAnswerHint = "Reply to the post instead";

    /// <summary> Emoji marking the pill as a place to write a reply. </summary>
    const string ComposerEmoji = "💬";

    /// <summary> Character drawn on the disc that stands in for a send button. </summary>
    const string ReturnKeyGlyph = "↵";

    /// <summary> Value <see cref="KeyboardEventArgs.Key"/> carries for the return key. </summary>
    const string ReturnKeyName = "Enter";

    /// <summary> Modifier lighting the send disc up once the text is sendable. </summary>
    const string ReadyHintClass = "comment-composer-send--ready";

    /// <summary> Tooltip on the send disc. </summary>
    const string SendHint = "Post this reply";

    /// <summary> Diameter of the spinner that replaces the return-key disc while the reply is being published; sized to sit in the same hole. </summary>
    const int BusySpinnerDiameterPx = AppMeasures.Size.Px20;

    /// <summary> Ring thickness of that spinner, thinned down from the app default so a disc this small still reads as a ring. </summary>
    const int BusySpinnerBorderPx = AppMeasures.Border.Medium;

    /// <summary> True when there is something to send and the caller is not already busy sending. </summary>
    bool CanSubmit => !IsBusy && !string.IsNullOrWhiteSpace(Text);

    /// <summary> The modifier class for the send disc, empty until the text is sendable. </summary>
    string ReadyHintModifier => CanSubmit ? ReadyHintClass : string.Empty;

    /// <summary> Sends what has been written, from a tap rather than a keystroke. </summary>
    /// <returns> A task that completes once the caller has handled the submission. </returns>
    async Task HandleSendAsync()
    {
        if (!CanSubmit) return;
        await OnSubmit.InvokeAsync();
    }

    /// <summary> The pill's frosted glass fill. </summary>
    string SurfaceStyle => AppStyles.BuildAcrylicStyle(AcrylicLevel.Subtle, AppMeasures.Blur.Subtle);

    /// <summary> Hands every keystroke straight back to the caller. </summary>
    /// <param name="args"> The input event; its value is the field's new contents. </param>
    /// <returns> A task that completes once the caller has taken the new text. </returns>
    Task HandleInputAsync(ChangeEventArgs args) => TextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    /// <summary>
    /// Writes a chosen account into what is being typed. The name goes on the end as its own word, with a space
    /// after it so the writer can keep going.
    /// </summary>
    /// <param name="address"> Address of the account that was picked. </param>
    /// <returns> A task that completes once the caller has taken the longer text. </returns>
    Task NameSomebodyAsync(string address)
    {
        string separator = Text.Length == 0 || char.IsWhiteSpace(Text[^1]) ? string.Empty : " ";
        return TextChanged.InvokeAsync($"{Text}{separator}{WrittenText.AccountMark}{address} ");
    }

    /// <summary> Sends on a bare return press, and ignores every other key. Return with shift held is left alone so it keeps its usual meaning. </summary>
    /// <param name="args"> The key that was pressed. </param>
    /// <returns> A task that completes once the caller has handled the submission, or immediately when the key was not a bare return. </returns>
    async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != ReturnKeyName || args.ShiftKey || !CanSubmit) return;
        await OnSubmit.InvokeAsync();
    }
}
