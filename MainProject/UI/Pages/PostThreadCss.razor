@namespace ChaySocial.MainProject.UI.Pages

@*
    Styling for PostThread. PostThread renders this component itself, so the thread always arrives with its own
    CSS attached. Only layout lives here: the header's glass and the composer pill's glass are inline styles
    built by AppStyles, so the material stays defined in one place.
*@
<style>
    .post-thread-screen {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(ThreadColumnMaximumWidthPx)px;
        margin: 0 auto;
        padding-bottom: @(ThreadBottomClearancePx)px;
        box-sizing: border-box;
    }

    /* Rides along the top of the scroll so the way back is always one tap away; the status-bar inset keeps the
       title clear of a phone's notch. */
    .post-thread-header {
        position: sticky;
        top: 0;
        z-index: @(AppMeasures.ZLayer.Sticky);
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.ScreenTopInset)px @(AppMeasures.Space.Px16)px @(AppMeasures.Space.Px12)px;
        box-sizing: border-box;
    }

    /* min-width:0 lets a long subtitle shrink instead of pushing the refresh spinner off the bar. */
    .post-thread-heading {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        flex: 1;
        min-width: 0;
    }

    .post-thread-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Tight);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .post-thread-subtitle {
        font-size: @(AppMeasures.Font.Small)px;
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .post-thread-first-load {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: @(AppMeasures.Viewport.Most)vh;
    }

    .post-thread-post,
    .post-thread-replies,
    .post-thread-composer {
        padding-left: @(AppMeasures.Space.Px16)px;
        padding-right: @(AppMeasures.Space.Px16)px;
        box-sizing: border-box;
    }

    /* The post lifts into place once; its replies each carry their own arrival animation. */
    .post-thread-post {
        animation: post-thread-arrive @(AppMeasures.Duration.Medium)s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .post-thread-replies {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
    }

    .post-thread-section-title {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        margin: 0 0 @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px4)px;
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Medium);
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .post-thread-section-emoji {
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    /* The way back out of one paragraph's notes. Drawn as a quiet line rather than a button, because leaving a
       narrower view is not an action anybody should have to look for. */
    .post-thread-show-all {
        align-self: flex-start;
        margin: 0 0 @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px4)px;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.Primary.ToRgbaHex(true));
        cursor: pointer;
    }

        .post-thread-show-all:hover {
            text-decoration: underline;
        }

    /* Sits just above the bottom navigation and stays there while the thread scrolls. The fade behind it is what
       stops replies from sliding out from under the pill with a hard edge. */
    .post-thread-composer {
        position: sticky;
        bottom: @(ComposerBottomOffsetPx)px;
        z-index: @(AppMeasures.ZLayer.Sticky);
        padding-top: @(AppMeasures.Space.Px16)px;
        padding-bottom: @(AppMeasures.Space.Px8)px;
        background: linear-gradient(to top, @(AppColors.BackgroundDeep.WithAlpha(ComposerFadeOpacity).ToRgbaHex(true)) @(ComposerFadeSolidStopPercent)%, transparent @(AppMeasures.Percent.Full)%);
    }

    @@keyframes post-thread-arrive {
        from {
            opacity: 0;
            transform: translateY(@(PostArrivalRisePx)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .post-thread-report {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: @(AppMeasures.Space.Px12)px;
        text-align: center;
    }

    .post-thread-report-emoji {
        font-size: @(AppMeasures.Font.Giant)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .post-thread-report-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .post-thread-report-subtitle {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .post-thread-report-reasons {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .post-thread-report-reason {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px14)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        text-align: left;
        cursor: pointer;
        transition: border-color @(AppMeasures.Duration.Fast)s, background @(AppMeasures.Duration.Fast)s;
    }

        .post-thread-report-reason:hover {
            border-color: @(AppColors.Warning.ToRgbaHex(true));
            background: @(AppColors.SurfaceTintAccent.ToRgbaHex(true));
        }

    .post-thread-report-reason-emoji {
        flex: none;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .post-thread-report-busy {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        padding: @(AppMeasures.Space.Px20)px 0;
    }

    .post-thread-report-busy-text {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }
</style>

@code {
    /// <summary> Widest the thread column grows on a large screen, so a reply never stretches into an unreadable band. </summary>
    const int ThreadColumnMaximumWidthPx = AppMeasures.Size.Px420;

    /// <summary> How far above the viewport's bottom edge the composer parks: exactly the height of the bottom navigation it must clear. </summary>
    const int ComposerBottomOffsetPx = AppMeasures.Space.ScrollBottomInset;

    /// <summary> Height the pinned composer occupies, fade included. Reserved at the end of the thread so the last reply can always be scrolled out from under it. </summary>
    const int PinnedComposerHeightPx = AppMeasures.Size.Px60;

    /// <summary> Empty space left under the last reply: the bottom navigation plus the composer parked above it. </summary>
    const int ThreadBottomClearancePx = ComposerBottomOffsetPx + PinnedComposerHeightPx;

    /// <summary> How solid the backdrop behind the composer is where it meets the bottom of the screen. </summary>
    const float ComposerFadeOpacity = 0.92f;

    /// <summary> How far up that backdrop stays solid before it starts fading to nothing. </summary>
    const int ComposerFadeSolidStopPercent = 55;

    /// <summary> How far the post slides up as it fades in. </summary>
    const int PostArrivalRisePx = AppMeasures.Space.Px12;
}
