@namespace ChaySocial.MainProject.UI.Pages

@*
    Styling for PageList. PageList renders this component itself, so the screen always arrives with its own CSS
    attached. Every selector is namespaced "page-list-*" because *Css.razor styles are global.
*@
<style>
    .page-list {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(ReadingColumnMaximumWidthPx)px;
        margin: 0 auto;
        padding: @(AppMeasures.Space.ScreenTopInset)px @(AppMeasures.Space.Px20)px @(ListBottomInsetPx)px;
        animation: page-list-arrive @(AppMeasures.Duration.Slow)s @SoftLandingEasing both;
    }

    .page-list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px16)px;
    }

    /* min-width:0 lets a long heading shrink instead of pushing the emoji off the row. */
    .page-list-header-text {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        min-width: 0;
    }

    .page-list-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Hero)px;
        font-weight: @(AppMeasures.Weight.Black);
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
        line-height: @(AppMeasures.LineHeight.Tight);
        background: linear-gradient(@(BrandGradientAngleDegrees)deg, @(AppColors.PrimaryLight.ToRgbaHex(true)), @(AppColors.Secondary.ToRgbaHex(true)));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .page-list-subtitle {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .page-list-header-emoji {
        flex-shrink: 0;
        font-size: @(AppMeasures.Font.Headline)px;
        line-height: @(AppMeasures.LineHeight.None);
        filter: drop-shadow(@AppStyles.ShadowPrimaryGlow);
    }

    .page-list-found-button {
        align-self: flex-start;
    }

    .page-list-found-emoji {
        margin-right: @(AppMeasures.Space.Px6)px;
    }

    .page-list-section {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
    }

    .page-list-section-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Tight);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .page-list-items {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
    }

    .page-list-item {
        display: block;
    }

    .page-list-row {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px16)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        transition: transform @(AppMeasures.Duration.Fast)s ease-out, box-shadow @(AppMeasures.Duration.Fast)s ease-out;
    }

    .page-list-row:hover {
        transform: translateY(-@(HoverLiftPx)px);
        box-shadow: @(AppStyles.ShadowMedium);
    }

    /* The row is the tap target that opens the page; the manage button sits outside it so pressing that never
       also navigates. */
    .page-list-open {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        flex: 1;
        min-width: 0;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        color: inherit;
        text-align: left;
        cursor: pointer;
    }

    /* min-width:0 lets a pasted address wrap inside the row rather than widening it past the screen. */
    .page-list-row-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px2)px;
        flex: 1;
        min-width: 0;
    }

    .page-list-row-name {
        min-width: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    .page-list-row-role {
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: @(AppMeasures.LineHeight.None);
        color: @(AppColors.PrimaryLight.ToRgbaHex(true));
    }

    .page-list-manage {
        flex: none;
    }

    .page-list-status {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.Px40)px @(AppMeasures.Space.Px24)px;
        text-align: center;
    }

    .page-list-status-text {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    /* --------------------------------------------------------------- the two sheets */

    .page-list-sheet {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: @(AppMeasures.Space.Px12)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(SheetMaximumWidthPx)px;
        text-align: left;
    }

    .page-list-sheet-emoji {
        align-self: center;
        font-size: @(AppMeasures.Font.Giant)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .page-list-sheet-title {
        margin: 0;
        text-align: center;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Tight);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .page-list-sheet-subtitle {
        margin: 0;
        text-align: center;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .page-list-field {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px14)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Large)px;
        font: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        outline: none;
    }

        .page-list-field:focus {
            border-color: @(AppColors.Primary.ToRgbaHex(true));
        }

    /* A fixed grid rather than a wrapping row, so the offered set never breaks with one choice left alone. */
    .page-list-avatar-row {
        display: grid;
        grid-template-columns: repeat(@(AvatarChoiceColumns), 1fr);
        justify-items: center;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .page-list-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: @(AvatarChoiceDiameterPx)px;
        height: @(AvatarChoiceDiameterPx)px;
        padding: 0;
        border-radius: @(AppMeasures.Radius.Circular)%;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
        cursor: pointer;
        transition: border-color @(AppMeasures.Duration.Fast)s, transform @(AppMeasures.Duration.Fast)s;
    }

        .page-list-avatar.is-chosen {
            border-color: @(AppColors.Primary.ToRgbaHex(true));
            background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
            transform: scale(@ChosenAvatarScale);
        }

        .page-list-avatar:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: default;
        }

    /* The editors scroll inside the sheet rather than growing it past the screen. */
    .page-list-editors {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        max-height: @(EditorListMaximumHeightPx)px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: @(AppColors.BorderStrong.ToRgbaHex(true)) transparent;
    }

    .page-list-editor {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
    }

    /* min-width:0 lets a long address wrap instead of widening the sheet. */
    .page-list-editor-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px2)px;
        flex: 1;
        min-width: 0;
    }

    .page-list-editor-name {
        min-width: 0;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    .page-list-editor-role {
        flex: none;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .page-list-editor-remove {
        flex: none;
        padding: 0 @(AppMeasures.Space.Px6)px;
        border: none;
        background: none;
        font: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        cursor: pointer;
    }

        .page-list-editor-remove:hover:not(:disabled) {
            color: @(AppColors.TextDanger.ToRgbaHex(true));
        }

    .page-list-error {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextDanger.ToRgbaHex(true));
    }

    .page-list-sheet-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px10)px;
    }

    @@keyframes page-list-arrive {
        from {
            opacity: 0;
            transform: translateY(@(PageArrivalRisePx)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Phone width: the screen keeps everything, it only gives back the padding it can spare. */
    @@media (max-width: @(NarrowScreenBreakpointPx)px) {
        .page-list {
            padding-left: @(AppMeasures.Space.Px14)px;
            padding-right: @(AppMeasures.Space.Px14)px;
        }

        .page-list-title {
            font-size: @(AppMeasures.Font.Title)px;
        }

        .page-list-row {
            flex-wrap: wrap;
        }

        .page-list-manage {
            width: @(AppMeasures.Percent.Full)%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .page-list {
            animation: none;
        }
    }
</style>

@code {
    /// <summary> Widest the column of pages grows. </summary>
    const int ReadingColumnMaximumWidthPx = 640;

    /// <summary> Space kept under the last row: the floating navigation's own height plus a gap. </summary>
    const int ListBottomInsetPx = AppMeasures.Space.ScrollBottomInset + AppMeasures.Space.Px40;

    /// <summary> Widest either sheet grows on a large screen. </summary>
    const int SheetMaximumWidthPx = 420;

    /// <summary> Side of one offered emoji in the founding sheet. </summary>
    const int AvatarChoiceDiameterPx = AppMeasures.Size.Px40;

    /// <summary> Emoji per row there; the offered set is a whole number of these. </summary>
    const int AvatarChoiceColumns = 4;

    /// <summary> How far the chosen emoji swells. A string so the decimal survives any OS culture. </summary>
    const string ChosenAvatarScale = "1.1";

    /// <summary> Tallest the editor list grows before it scrolls inside the sheet. </summary>
    const int EditorListMaximumHeightPx = 240;

    /// <summary> Angle of the two-colour sheen through the heading. </summary>
    const int BrandGradientAngleDegrees = 135;

    /// <summary> How far the screen slides up as it fades in. </summary>
    const int PageArrivalRisePx = AppMeasures.Space.Px12;

    /// <summary> How far a row lifts under the pointer. </summary>
    const int HoverLiftPx = AppMeasures.Space.Px2;

    /// <summary> Easing that starts fast and settles softly. </summary>
    const string SoftLandingEasing = "cubic-bezier(0.16, 1, 0.3, 1)";

    /// <summary> Widest viewport still treated as a phone. </summary>
    const int NarrowScreenBreakpointPx = AppMeasures.Size.Px420;
}
