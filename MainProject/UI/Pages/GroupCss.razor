@namespace ChaySocial.MainProject.UI.Pages

@*
    Styling for Group. Group renders this component itself, so the page always arrives with its own CSS attached.
    Only layout lives here: the header's glass is an inline style built by AppStyles, so the material stays
    defined in one place.
*@
<style>
    .group-screen {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(ReadingColumnMaximumWidthPx)px;
        margin: 0 auto;
        padding-bottom: @(ListBottomInsetPx)px;
    }

    /* Rides along the top of the scroll so the way back is always one tap away; the status-bar inset keeps the
       name clear of a phone's notch. */
    .group-header {
        position: sticky;
        top: 0;
        z-index: @(AppMeasures.ZLayer.Sticky);
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.ScreenTopInset)px @(AppMeasures.Space.Px16)px @(AppMeasures.Space.Px12)px;
    }

    /* min-width:0 lets a long name shrink instead of pushing the refresh throbber off the bar. */
    .group-heading {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        flex: 1;
        min-width: 0;
    }

    .group-heading-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Tight);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .group-heading-members {
        font-size: @(AppMeasures.Font.Small)px;
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-variant-numeric: tabular-nums;
    }

    .group-first-load {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: @(AppMeasures.Viewport.Most)vh;
    }

    .group-card {
        margin: 0 @(AppMeasures.Space.Px16)px;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .group-identity {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .group-avatar {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: @(AvatarDiameterPx)px;
        height: @(AvatarDiameterPx)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        font-size: @(AppMeasures.Font.Headline)px;
        line-height: @(AppMeasures.LineHeight.None);
        background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderTop.ToRgbaHex(true));
    }

    /* min-width:0 lets a pasted address wrap inside the card instead of widening it past the screen. */
    .group-identity-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px4)px;
        flex: 1;
        min-width: 0;
    }

    .group-name {
        min-width: 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    /* pre-wrap keeps the founder's own line breaks; overflow-wrap stops a long word widening the card. */
    .group-description {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .group-badge-row {
        display: flex;
    }

    .group-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px10)px;
    }

    /* Says what the reader is here rather than offering a control: a founder cannot leave, and nobody can let
       themselves into a closed room. */
    .group-role {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Medium);
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .group-feed {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
        padding: 0 @(AppMeasures.Space.Px16)px;
    }

    /* Phone width: the page keeps everything, it only gives back the padding it can spare. */
    @@media (max-width: @(NarrowScreenBreakpointPx)px) {
        .group-header,
        .group-feed {
            padding-left: @(AppMeasures.Space.Px14)px;
            padding-right: @(AppMeasures.Space.Px14)px;
        }

        .group-card {
            margin-left: @(AppMeasures.Space.Px14)px;
            margin-right: @(AppMeasures.Space.Px14)px;
        }
    }
</style>

@code {
    /// <summary> Widest the column of posts grows; past this a line gets tiring to track back to. </summary>
    const int ReadingColumnMaximumWidthPx = 640;

    /// <summary> Space kept under the last post: the floating navigation's own height plus a gap. </summary>
    const int ListBottomInsetPx = AppMeasures.Space.ScrollBottomInset + AppMeasures.Space.Px40;

    /// <summary> Side of the round emoji chip standing in for the group's picture. </summary>
    const int AvatarDiameterPx = AppMeasures.Size.Px64;

    /// <summary> Widest viewport still treated as a phone, below which the page tightens its spacing. </summary>
    const int NarrowScreenBreakpointPx = AppMeasures.Size.Px420;
}
