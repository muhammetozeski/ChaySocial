@*
    Styling for the Welcome page. Welcome renders this component itself, so the first screen always arrives
    with its own CSS attached. Every value comes from C# — the shared theme tokens where one exists, and a
    named constant in this file's @@code block where the measurement belongs to this screen alone.
*@
<style>
    .welcome-screen {
        min-height: @(AppMeasures.Viewport.Full)vh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
        padding: @(AppMeasures.Space.ScreenTopInset)px @(AppMeasures.Space.Px24)px @(AppMeasures.Space.ScrollBottomInset)px;
        text-align: center;
    }

    /* Square frame the mark and its glow are centred in, so the bobbing emoji never nudges the name below it. */
    .welcome-mark {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: @(BrandMarkFrameDiameterPx)px;
        height: @(BrandMarkFrameDiameterPx)px;
    }

    /* Blurred disc of the primary hue behind the mark, so the screen opens on a glow rather than on bare background. */
    .welcome-mark-halo {
        position: absolute;
        width: @(BrandHaloDiameterPx)px;
        height: @(BrandHaloDiameterPx)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: @(AppColors.Primary.WithAlpha(BrandHaloTintOpacity).ToRgbaHex(true));
        filter: blur(@(AppMeasures.Blur.Heavy)px);
        animation: welcome-breathe @(AppMeasures.Duration.Slowest)s ease-in-out infinite;
    }

    .welcome-mark-emoji {
        position: relative;
        font-size: @(AppMeasures.Font.Mega)px;
        line-height: @(AppMeasures.LineHeight.None);
        animation: welcome-bob @(AppMeasures.Duration.Slowest)s ease-in-out infinite;
    }

    /* The name carries the aurora itself: a primary → secondary → accent sheen clipped to the glyphs. The solid
       color underneath is what shows if a renderer ignores background-clip, so the name is never invisible. */
    .welcome-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Hero)px;
        font-weight: @(AppMeasures.Weight.Black);
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        background-image: linear-gradient(@TitleSheenAngle, @(AppColors.Primary.ToRgbaHex(true)), @(AppColors.Secondary.ToRgbaHex(true)), @(AppColors.Accent.ToRgbaHex(true)));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: welcome-arrive @(AppMeasures.Duration.Slow)s @ArrivalEasing both;
    }

    .welcome-tagline {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        animation: welcome-arrive @(AppMeasures.Duration.Slow)s @ArrivalEasing both;
    }

    .welcome-card {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(CardMaximumWidthPx)px;
        margin-top: @(AppMeasures.Space.Px20)px;
        animation: welcome-arrive @(AppMeasures.Duration.Slower)s @ArrivalEasing both;
    }

    .welcome-promise-line {
        margin: 0 0 @(AppMeasures.Space.Px16)px 0;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .welcome-promise-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
        margin-bottom: @(AppMeasures.Space.Px20)px;
    }

    .welcome-button-emoji {
        font-size: @(AppMeasures.Font.Large)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    /* The quiet second path. It is a plain text row until it is hovered or focused, so it never competes with
       the create button beside it. */
    .welcome-recall-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
        width: @(AppMeasures.Percent.Full)%;
        margin-top: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px16)px;
        border: none;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: transparent;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        transition: background @(AppMeasures.Duration.Fast)s, color @(AppMeasures.Duration.Fast)s;
    }

        .welcome-recall-toggle:hover:not(:disabled) {
            background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
            color: @(AppColors.TextPrimary.ToRgbaHex(true));
        }

        .welcome-recall-toggle:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }

    .welcome-recall-toggle-emoji {
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .welcome-recall-caret {
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.None);
        transition: transform @(AppMeasures.Duration.Fast)s;
    }

    .welcome-recall-caret--open {
        transform: rotate(@CaretOpenRotation);
    }

    .welcome-recall-panel {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px12)px;
        margin-top: @(AppMeasures.Space.Px12)px;
        animation: welcome-reveal @(AppMeasures.Duration.Normal)s @ArrivalEasing both;
    }

    /* Both secret boxes — the one a returning owner pastes into and the readonly one a new owner copies out of —
       share this monospace, wide-tracked look, because both hold the same grouped characters. */
    .welcome-secret-box {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        resize: none;
        padding: @(AppMeasures.Space.Px14)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.BackgroundDeep.WithAlpha(SecretBoxTintOpacity).ToRgbaHex(true));
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-family: @SecretFontStack;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        letter-spacing: @(AppMeasures.Tracking.Wide)px;
        text-align: center;
        transition: border-color @(AppMeasures.Duration.Fast)s, box-shadow @(AppMeasures.Duration.Fast)s;
    }

        .welcome-secret-box::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
            letter-spacing: @(AppMeasures.Tracking.Normal)px;
        }

        .welcome-secret-box:focus {
            outline: none;
            border-color: @(AppColors.Primary.ToRgbaHex(true));
            box-shadow: @AppStyles.ShadowPrimaryGlow;
        }

        .welcome-secret-box:disabled {
            opacity: @(AppMeasures.Opacity.Dim);
        }

        /* The freshly drawn secret. It reads as the most valuable thing on the screen because it is: an amber
           ring and a steady glow, so nobody scrolls past it by accident. */
        .welcome-secret-box--kept {
            border-color: @(AppColors.Accent.ToRgbaHex(true));
            box-shadow: @AppStyles.ShadowGoldGlow;
            color: @(AppColors.TextPrimary.ToRgbaHex(true));
            font-weight: @(AppMeasures.Weight.Heavy);
        }

    .welcome-secret-headline {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
        margin: 0 0 @(AppMeasures.Space.Px8)px 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .welcome-secret-headline-emoji {
        font-size: @(AppMeasures.Font.Title)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .welcome-secret-lead {
        margin: 0 0 @(AppMeasures.Space.Px16)px 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .welcome-secret-warning {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px10)px;
        margin: @(AppMeasures.Space.Px16)px 0;
        padding: @(AppMeasures.Space.Px14)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.Warning.WithAlpha(WarningEdgeOpacity).ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.Warning.WithAlpha(WarningTintOpacity).ToRgbaHex(true));
        text-align: left;
    }

    .welcome-secret-warning-emoji {
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
    }

    .welcome-secret-warning-text {
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextWarning.ToRgbaHex(true));
    }

    .welcome-error {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextDanger.ToRgbaHex(true));
        animation: welcome-reveal @(AppMeasures.Duration.Fast)s @ArrivalEasing both;
    }

    /* The line that explains the pause while an account's proof of work is being solved. It pulses gently so a
       wait of a few seconds reads as work in progress rather than a frozen screen. */
    .welcome-proof {
        margin: 0;
        text-align: center;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        animation: welcome-proof-pulse @(AppMeasures.Duration.Longer)s ease-in-out infinite;
    }

    @@keyframes welcome-proof-pulse {
        0%, 100% {
            opacity: @(AppMeasures.Opacity.Dim);
        }

        50% {
            opacity: 1;
        }
    }

    @@keyframes welcome-arrive {
        from {
            opacity: 0;
            transform: translateY(@(ArrivalRisePx)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes welcome-reveal {
        from {
            opacity: 0;
            transform: translateY(-@(RevealDropPx)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes welcome-bob {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-@(BrandBobLiftPx)px);
        }
    }

    @@keyframes welcome-breathe {
        0%, 100% {
            opacity: @(AppMeasures.Opacity.Dim);
            transform: scale(1);
        }

        50% {
            opacity: @(AppMeasures.Opacity.Bright);
            transform: scale(@BrandHaloBreathPeakScale);
        }
    }
</style>

@code {
    /// <summary> Side of the square that holds the brand emoji and its halo. Wide enough that the halo's blur fades out before it reaches the app name. </summary>
    const int BrandMarkFrameDiameterPx = AppMeasures.Size.Px120;

    /// <summary> Diameter of the blurred glow disc behind the brand emoji; kept under the frame so the blur has room to fall off. </summary>
    const int BrandHaloDiameterPx = AppMeasures.Size.Px100;

    /// <summary> How solid the halo's primary tint is before the blur spreads it. </summary>
    const float BrandHaloTintOpacity = 0.55f;

    /// <summary> Widest the halo swells to while breathing. A string so the decimal point survives any OS culture. </summary>
    const string BrandHaloBreathPeakScale = "1.14";

    /// <summary> How far the brand emoji rises at the top of its idle bob. </summary>
    const int BrandBobLiftPx = AppMeasures.Space.Px8;

    /// <summary> Caps the card's width so the screen reads as one narrow column on a desktop window instead of a stretched band. </summary>
    const int CardMaximumWidthPx = AppMeasures.Size.Px420;

    /// <summary> How far the name, tagline and card slide up as they fade in. </summary>
    const int ArrivalRisePx = AppMeasures.Space.Px16;

    /// <summary> How far a revealed panel drops from as it fades in, so it reads as unfolding out of the row above it. </summary>
    const int RevealDropPx = AppMeasures.Space.Px8;

    /// <summary> Easing shared by every entrance on this screen: a fast start that settles gently, so the app opens softly rather than snapping into place. </summary>
    const string ArrivalEasing = "cubic-bezier(0.16, 1, 0.3, 1)";

    /// <summary> Direction the app name's colour sheen runs in: a diagonal, so the three theme hues all reach the glyphs. </summary>
    const string TitleSheenAngle = "135deg";

    /// <summary> Half a turn, which points the caret beside the returning-owner row upward once its panel is open. </summary>
    const string CaretOpenRotation = "180deg";

    /// <summary> How deeply the secret boxes are sunk into the card: a dark well under the glass, so the characters read as something set apart from the surrounding text. </summary>
    const float SecretBoxTintOpacity = 0.45f;

    /// <summary> How solid the amber wash behind the warning panel is — enough to tint the glass, not enough to hide it. </summary>
    const float WarningTintOpacity = 0.14f;

    /// <summary> How solid the amber hairline around the warning panel is. </summary>
    const float WarningEdgeOpacity = 0.35f;

    /// <summary> Typeface stack for the grouped secret characters: fixed-width faces first so every group lines up, falling back to whatever monospace the device has. </summary>
    const string SecretFontStack = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
}
