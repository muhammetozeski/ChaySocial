@*
    Styling for the Statement page. The page renders this itself, so it always arrives with its own CSS attached.
    Every selector is namespaced "statement-*" because *Css.razor styles are global.
*@
<style>
    .statement-page {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(PageMaximumWidthPx)px;
        margin: 0 auto;
        padding: @(AppMeasures.Space.ScreenTopInset)px @(AppMeasures.Space.Px20)px @(AppMeasures.Space.Px24)px;
    }

    .statement-header {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .statement-header-text {
        flex: 1;
        min-width: 0;
    }

    .statement-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .statement-subtitle {
        margin: @(AppMeasures.Space.Px4)px 0 0 0;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .statement-header-emoji {
        font-size: @(AppMeasures.Font.Hero)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .statement-card {
        width: @(AppMeasures.Percent.Full)%;
        box-sizing: border-box;
    }

    .statement-section-heading {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .statement-section-emoji {
        font-size: @(AppMeasures.Font.Large)px;
    }

    .statement-section-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .statement-section-description {
        margin: @(AppMeasures.Space.Px8)px 0 @(AppMeasures.Space.Px16)px 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    /* The claim reads as prose, because it is a sentence somebody wrote rather than data. */
    .statement-claim {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px16)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        resize: vertical;
    }

        .statement-claim::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
        }

        .statement-claim:focus {
            outline: none;
            border-color: @(AppColors.PrimaryLight.ToRgbaHex(true));
        }

    .statement-counter {
        margin: @(AppMeasures.Space.Px6)px 0 @(AppMeasures.Space.Px12)px 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        text-align: right;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    /* Both real actions, styled alike because signing and checking are the same weight of thing. */
    .statement-action {
        width: @(AppMeasures.Percent.Full)%;
        box-sizing: border-box;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px20)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font: inherit;
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        cursor: pointer;
    }

        .statement-action:hover:not(:disabled) {
            border-color: @(AppColors.PrimaryLight.ToRgbaHex(true));
        }

        .statement-action:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: default;
        }

    .statement-download {
        display: block;
        margin-top: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px20)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @(AppColors.PrimaryLight.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.TextOnAccent.ToRgbaHex(true));
        text-align: center;
        text-decoration: none;
    }

    .statement-fallback-label {
        margin: @(AppMeasures.Space.Px16)px 0 @(AppMeasures.Space.Px6)px 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    /* The block itself. Fixed-width faces, so it reads as data rather than as prose. */
    .statement-fallback {
        width: @(AppMeasures.Percent.Full)%;
        box-sizing: border-box;
        padding: @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        background: @(AppColors.BackgroundDeep.ToRgbaHex(true));
        font-family: @StatementTypeface;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        resize: vertical;
    }

    /* The real input is hidden behind its own label, because a bare file input cannot be styled and looks foreign. */
    .statement-pick {
        display: block;
        position: relative;
        overflow: hidden;
    }

    .statement-pick-input {
        position: absolute;
        inset: 0;
        width: @(AppMeasures.Percent.Full)%;
        height: @(AppMeasures.Percent.Full)%;
        opacity: 0;
        cursor: pointer;
    }

    .statement-pick-label {
        display: block;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px20)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px dashed @(AppColors.BorderSoft.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        text-align: center;
    }

    .statement-failure {
        margin: @(AppMeasures.Space.Px12)px 0 0 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.Warning.ToRgbaHex(true));
    }

    /* What a checked block says, laid out as one answer: the mark, the address, the sentence, and the verdict. */
    .statement-verdict {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        margin-top: @(AppMeasures.Space.Px16)px;
        padding: @(AppMeasures.Space.Px16)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        text-align: center;
    }

        /* The chip lays itself out at the width of its own text, which leaves the field holding the whole address
           too narrow to read one. Somebody checking a claim is comparing that address character by character, so
           here it is given the card's width instead. */
        .statement-verdict .address-chip {
            width: @(AppMeasures.Percent.Full)%;
            align-items: center;
        }

    .statement-claim-shown {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    .statement-signed-at {
        margin: 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .statement-held {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextSuccess.ToRgbaHex(true));
    }

    .statement-broken {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextDanger.ToRgbaHex(true));
    }
</style>

@code {
    /// <summary> Widest the page's column grows, so a block's text does not stretch into an unreadable line. </summary>
    const int PageMaximumWidthPx = 640;

    /// <summary> Typeface for the block's text: fixed-width, so it reads as data rather than as prose. </summary>
    const string StatementTypeface = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
}
