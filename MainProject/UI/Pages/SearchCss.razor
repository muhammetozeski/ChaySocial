@namespace ChaySocial.MainProject.UI.Pages

@*
    Styling for the Search page. Search renders this component itself, so the page can never arrive unstyled.
*@
<style>
    .search-screen {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px20)px;
        padding-bottom: @(AppMeasures.Space.ScrollBottomInset)px;
    }

    /* Rides along the top of the scroll, so the field stays within reach however far the results run. */
    .search-header {
        @(AppStyles.BuildBarSurface(pinnedToBottom: false))
        position: sticky;
        top: 0;
        z-index: @(AppMeasures.ZLayer.Sticky);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(HeaderTopPaddingPx)px @(AppMeasures.Space.Px20)px @(AppMeasures.Space.Px16)px;
    }

    .search-heading {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        margin: 0;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Bold);
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .search-heading-emoji {
        font-size: @(AppMeasures.Font.Large)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .search-field {
        @(AppStyles.BuildAcrylicStyle(AcrylicLevel.Normal, AppMeasures.Blur.Subtle))
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px10)px;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px16)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        transition: border-color @(AppMeasures.Duration.Fast)s ease-out, box-shadow @(AppMeasures.Duration.Fast)s ease-out;
    }

        /* The whole pill lights up around the caret, so the field reads as the live thing on the page. */
        .search-field:focus-within {
            border-color: @(AppColors.Primary.ToRgbaHex(true));
            box-shadow: @(AppStyles.GetGlow(AppColors.Primary, FieldFocusGlowOpacity));
        }

    .search-field-emoji {
        flex: none;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    /* Stripped back to bare text: the surrounding pill owns the whole look of the field. */
    .search-field-input {
        flex: 1;
        min-width: 0;
        margin: 0;
        padding: 0;
        border: none;
        outline: none;
        background: none;
        font: inherit;
        font-size: @(AppMeasures.Font.Medium)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        -webkit-appearance: none;
        appearance: none;
    }

        .search-field-input::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
        }

        /* A search input draws its own clear cross; this page has its own button, so the built-in one goes. */
        .search-field-input::-webkit-search-cancel-button {
            -webkit-appearance: none;
            appearance: none;
        }

    .search-field-clear {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: @(ClearButtonDiameterPx)px;
        height: @(ClearButtonDiameterPx)px;
        padding: 0;
        border: none;
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.None);
        cursor: pointer;
        transition: background @(AppMeasures.Duration.Fast)s ease-out, transform @(AppMeasures.Duration.Fast)s ease-out;
    }

        .search-field-clear:hover {
            background: @(AppColors.SurfaceStrong.ToRgbaHex(true));
        }

        .search-field-clear:active {
            transform: scale(@ClearPressedScale);
        }

        .search-field-clear:focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @(AppColors.Primary.ToRgbaHex(true));
            outline-offset: @(AppMeasures.Space.Px2)px;
        }

    .search-results {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px24)px;
        padding: 0 @(AppMeasures.Space.Px20)px;
    }

    .search-section {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px12)px;
        animation: search-section-arrive @(AppMeasures.Duration.Medium)s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

        /* The posts section follows the people section in, so the two land one after the other rather than together. */
        .search-section + .search-section {
            animation-delay: @(AppMeasures.Duration.Instant)s;
        }

    .search-section-heading {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        margin: 0;
        padding-left: @(AppMeasures.Space.Px4)px;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        letter-spacing: @(AppMeasures.Tracking.Widest)px;
        text-transform: uppercase;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .search-section-emoji {
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.None);
        letter-spacing: normal;
    }

    /* The tally sits in its own tinted pill, so the heading reads as "People 3" without needing a separator. */
    .search-section-count {
        min-width: @(SectionCountMinimumWidthPx)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.XSmall)px;
        letter-spacing: normal;
        text-align: center;
    }

    .search-section-list {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px12)px;
    }

    @@keyframes search-section-arrive {
        from {
            opacity: 0;
            transform: translateY(@(SectionArriveRisePx)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .search-section {
            animation: none;
        }

        .search-field,
        .search-field-clear {
            transition: none;
        }
    }
</style>

@code {
    /// <summary> Top padding of the sticky header, which pushes the title clear of the device status bar. </summary>
    const int HeaderTopPaddingPx = AppMeasures.Space.ScreenTopInset;

    /// <summary> How solid the primary halo around the focused field is; bright enough to read as light, soft enough not to glare. </summary>
    const float FieldFocusGlowOpacity = 0.35f;

    /// <summary> Side of the round button that empties the field, sized to sit inside the pill without stretching it. </summary>
    const int ClearButtonDiameterPx = AppMeasures.Size.Px28;

    /// <summary> How far that button shrinks while held down. A string so the decimal survives any OS culture. </summary>
    const string ClearPressedScale = "0.9";

    /// <summary> Narrowest the count pill may be, so a one-digit tally stays as wide as a two-digit one and headings do not jump. </summary>
    const int SectionCountMinimumWidthPx = AppMeasures.Size.Px20;

    /// <summary> How far a section starts below its resting place, so it rises into position as it fades in. </summary>
    const int SectionArriveRisePx = AppMeasures.Space.Px12;
}
