@namespace ChaySocial.MainProject.UI.Pages

@* Styles for the Profile page. Every selector is namespaced "profile-*" because *Css.razor styles are global
   (this project uses no CSS isolation), so bare names would leak into every other component. All colours, sizes
   and timings come from C# tokens, so a theme swap restyles the page on the next render. *@
<style>
    .profile-screen {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px20)px;
        padding: @(AppMeasures.Space.ScreenTopInset)px @(AppMeasures.Space.Px20)px @(AppMeasures.Space.Px40)px;
    }

    /* Holds the first-load throbber in the middle of the space the page will fill. */
    .profile-centered {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: @(ScreenPlaceholderHeightVh)vh;
    }

    /* A quiet pulse above the content while a refresh runs, so the page never blanks out under the reader. */
    .profile-refreshing {
        height: @(AppMeasures.Size.Px4)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: linear-gradient(@(HorizontalSweepAngleDegrees)deg, transparent, @(AppColors.Primary.ToRgbaHex(true)), transparent);
        animation: profile-refresh-pulse @(AppMeasures.Duration.Longer)s ease-in-out infinite;
    }

    .profile-inline-failure {
        margin: 0;
        color: @(AppColors.TextWarning.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
    }

    .profile-notice-row {
        display: flex;
        align-items: center;
    }

    /* Every card on this page rises into place the same way a post card does, so the whole screen settles as one. */
    .profile-card {
        gap: @(AppMeasures.Space.Px16)px;
        animation: profile-rise @(AppMeasures.Duration.Normal)s @SoftLandingEasing both;
    }

    .profile-failure {
        align-items: center;
        text-align: center;
    }

    .profile-failure-emoji {
        font-size: @(AppMeasures.Font.Hero)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .profile-failure-text {
        margin: 0;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
    }

    .profile-header-top {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px16)px;
    }

    /* min-width:0 lets the name and address actually shrink, which is what makes their ellipsis work. */
    .profile-identity {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        min-width: 0;
    }

    .profile-name {
        margin: 0;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Bold);
        line-height: @(AppMeasures.LineHeight.Tight);
        overflow-wrap: anywhere;
    }

    .profile-address-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
        min-width: 0;
    }

    /* The eye that reveals the whole address. Small, round and quiet — it is a detail, not an action. */
    .profile-address-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: @(AppMeasures.Size.Px28)px;
        height: @(AppMeasures.Size.Px28)px;
        padding: 0;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.None);
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s @SoftLandingEasing, border-color @(AppMeasures.Duration.Fast)s;
    }

        .profile-address-toggle:active {
            transform: scale(@PressedScale);
        }

        .profile-address-toggle:focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @(AppColors.Primary.ToRgbaHex(true));
            outline-offset: @(AppMeasures.Space.Px2)px;
        }

    .profile-blocked-row {
        display: flex;
        align-items: center;
    }

    .profile-bio {
        margin: 0;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .profile-joined {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        margin: 0;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
    }

    .profile-joined-emoji {
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .profile-counts {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px10)px;
    }

    /* Each total is its own little frosted tile, so three numbers read as three facts rather than one sentence. */
    .profile-count {
        display: flex;
        flex: 1 1 @(AppMeasures.Size.Px80)px;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px12)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Large)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
    }

    .profile-count-value {
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        font-variant-numeric: tabular-nums;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .profile-count-label {
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.XSmall)px;
        letter-spacing: @(AppMeasures.Tracking.Wide)px;
        text-transform: uppercase;
    }

    .profile-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px10)px;
    }

    .profile-action-button {
        white-space: nowrap;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .profile-action-emoji {
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .profile-section-title {
        margin: 0;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
    }

    .profile-field {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .profile-field-label {
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Medium);
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
    }

    .profile-input,
    .profile-textarea {
        box-sizing: border-box;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px14)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-family: inherit;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        transition: border-color @(AppMeasures.Duration.Fast)s, box-shadow @(AppMeasures.Duration.Fast)s;
    }

    .profile-textarea {
        resize: vertical;
    }

        .profile-input::placeholder,
        .profile-textarea::placeholder {
            color: @(AppColors.TextMuted.ToRgbaHex(true));
        }

        .profile-input:focus,
        .profile-textarea:focus {
            outline: none;
            border-color: @(AppColors.Primary.ToRgbaHex(true));
            box-shadow: @(AppStyles.ShadowPrimaryGlow);
        }

        .profile-input:disabled,
        .profile-textarea:disabled {
            opacity: @(AppMeasures.Opacity.Dim);
        }

    .profile-counter {
        align-self: flex-end;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.XSmall)px;
        font-variant-numeric: tabular-nums;
    }

    .profile-avatar-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(@(AvatarChoiceDiameterPx)px, 1fr));
        gap: @(AppMeasures.Space.Px8)px;
    }

    /* One emoji per circle. Picking a face is the friendliest thing on this page, so the tiles are round and springy. */
    .profile-avatar-choice {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
        padding: 0;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Large)px;
        line-height: @(AppMeasures.LineHeight.None);
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s @SoftLandingEasing, border-color @(AppMeasures.Duration.Fast)s, box-shadow @(AppMeasures.Duration.Fast)s;
    }

        .profile-avatar-choice:active:not(:disabled) {
            transform: scale(@PressedScale);
        }

        .profile-avatar-choice:focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @(AppColors.Primary.ToRgbaHex(true));
            outline-offset: @(AppMeasures.Space.Px2)px;
        }

        .profile-avatar-choice:disabled {
            opacity: @(AppMeasures.Opacity.Dim);
            cursor: not-allowed;
        }

    .profile-avatar-choice--picked {
        border-color: @(AppColors.Primary.ToRgbaHex(true));
        background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
        box-shadow: @(AppStyles.ShadowPrimaryGlow);
        animation: profile-avatar-pop @(AppMeasures.Duration.Medium)s @PlayfulOvershootEasing;
    }

    .profile-error {
        margin: 0;
        color: @(AppColors.TextDanger.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Small)px;
    }

    .profile-posts {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
    }

    .profile-modal {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Px12)px;
        width: @(AppMeasures.Size.Px320)px;
        max-width: @(AppMeasures.Percent.Full)%;
        text-align: center;
    }

    .profile-modal-emoji {
        font-size: @(AppMeasures.Font.Hero)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .profile-modal-title {
        margin: 0;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        line-height: @(AppMeasures.LineHeight.Tight);
        overflow-wrap: anywhere;
    }

    .profile-modal-text {
        margin: 0;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
    }

    .profile-modal-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px10)px;
    }

    .profile-reason-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .profile-reason {
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        font-family: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Medium);
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s @SoftLandingEasing, background @(AppMeasures.Duration.Fast)s, color @(AppMeasures.Duration.Fast)s, border-color @(AppMeasures.Duration.Fast)s;
    }

        .profile-reason:active:not(:disabled) {
            transform: scale(@PressedScale);
        }

        .profile-reason:focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @(AppColors.Primary.ToRgbaHex(true));
            outline-offset: @(AppMeasures.Space.Px2)px;
        }

        .profile-reason:disabled {
            opacity: @(AppMeasures.Opacity.Dim);
            cursor: not-allowed;
        }

    .profile-reason--picked {
        border-color: @(AppColors.Primary.ToRgbaHex(true));
        background: @(AppColors.SurfaceTintPrimary.ToRgbaHex(true));
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    @@keyframes profile-rise {
        from {
            opacity: 0;
            transform: translateY(@(AppMeasures.Space.Px12)px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes profile-avatar-pop {
        0% {
            transform: scale(1);
        }

        @(AppMeasures.Percent.Half)% {
            transform: scale(@AvatarPopPeakScale);
        }

        @(AppMeasures.Percent.Full)% {
            transform: scale(1);
        }
    }

    @@keyframes profile-refresh-pulse {
        0% {
            opacity: @(AppMeasures.Opacity.Disabled);
        }

        @(AppMeasures.Percent.Half)% {
            opacity: 1;
        }

        @(AppMeasures.Percent.Full)% {
            opacity: @(AppMeasures.Opacity.Disabled);
        }
    }

    /* Phone width: the header stacks so a long name never squeezes the avatar off the screen. */
    @@media (max-width: @(NarrowScreenBreakpointPx)px) {
        .profile-screen {
            padding-left: @(AppMeasures.Space.Px16)px;
            padding-right: @(AppMeasures.Space.Px16)px;
        }

        .profile-header-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-name {
            font-size: @(AppMeasures.Font.Large)px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .profile-card,
        .profile-avatar-choice--picked,
        .profile-refreshing {
            animation: none;
        }

        .profile-address-toggle,
        .profile-avatar-choice,
        .profile-reason {
            transition: none;
        }

            .profile-address-toggle:active,
            .profile-avatar-choice:active:not(:disabled),
            .profile-reason:active:not(:disabled) {
                transform: none;
            }
    }
</style>

@code {
    /// <summary> Height the first-load throbber is centred in, as a share of the viewport, so the spinner sits where the header will appear rather than at the very top. </summary>
    const int ScreenPlaceholderHeightVh = AppMeasures.Viewport.Most;

    /// <summary> Angle the refresh pulse runs its gradient along: left to right across the bar. </summary>
    const int HorizontalSweepAngleDegrees = 90;

    /// <summary> Width of one emoji tile in the avatar picker, and therefore how many tiles fit a row. </summary>
    const int AvatarChoiceDiameterPx = AppMeasures.Size.Px44;

    /// <summary> How far a pressable control shrinks while it is held down — the same press feedback the core button gives. </summary>
    const string PressedScale = "0.95";

    /// <summary> How far the picked emoji swells at the top of its pop before settling back. </summary>
    const string AvatarPopPeakScale = "1.2";

    /// <summary> Easing that starts fast and settles softly, used for entrances and presses. </summary>
    const string SoftLandingEasing = "cubic-bezier(0.16, 1, 0.3, 1)";

    /// <summary> Easing that overshoots past its target before coming back, which is what makes the emoji pop read as playful. </summary>
    const string PlayfulOvershootEasing = "cubic-bezier(0.34, 1.56, 0.64, 1)";

    /// <summary> Widest viewport still treated as a phone, below which the header stacks and the page tightens its side padding. </summary>
    const int NarrowScreenBreakpointPx = AppMeasures.Size.Px420;
}
