@*
    The shell every page is drawn inside: the aurora background and body typography come from
    <MainLayoutCss />, the routed page fills the content area, and the bottom navigation appears only once
    somebody is signed in — a signed-out visitor sees the welcome screen with nothing to navigate to yet.

    Nothing routed is drawn until the stored session has been read back. Reading it needs the browser storage,
    which is only reachable once the app is running, so any page rendered before that would decide the visitor
    is a stranger and bounce them to the welcome screen — which is what used to happen to every deep link.
*@
@using ChaySocial.MainProject.Moderation
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavManager

@* Keyed on the palette's name so switching themes rebuilds the whole tree. Every component writes its colours
   into its own <style> block at render time, and those blocks only change if that component renders again — a
   redraw of the layout alone repaints nothing below it. *@
<div class="app-page @(ShowBottomNavigation ? HasBottomNavClass : string.Empty)" @key="ThemeManager.Current.Name">

    @* Above everything, because it changes what every screen below it means: what is on them came out of a file
       and nothing is being talked to. *@
    @if (OfflineReadingService.IsReading)
    {
        <div class="app-offline">
            <span class="app-offline-mark">@OfflineEmoji</span>

            <div class="app-offline-text">
                <span class="app-offline-title">@OfflineHeadline</span>
                <span class="app-offline-detail">@OfflineDetail</span>
            </div>

            <button type="button" class="app-offline-action" @onclick="TalkToAServerAgainAsync">@OfflineActionLabel</button>
        </div>
    }

    <main>
        <article class="content">
            @if (_isSessionReady && _isTorBlocked)
            {
                @* Drawn instead of the app, not over it: somebody who asked to be refused without Tor should not
                   have the app quietly working behind a notice. *@
                <div class="app-blocked">
                    <span class="app-blocked-mark">@TorBlockedEmoji</span>
                    <h1 class="app-blocked-title">@TorBlockedHeadline</h1>
                    <p class="app-blocked-text">@TorBlockedDescription</p>
                    <p class="app-blocked-host">@NavManager.BaseUri</p>

                    <button type="button" class="app-blocked-release" @onclick="ReleaseTorRequirementAsync">
                        @TorBlockedReleaseLabel
                    </button>
                </div>
            }
            else if (_isSessionReady)
            {
                @Body
            }
            else
            {
                <div class="app-waking">
                    <span class="app-waking-mark">@WakingEmoji</span>
                    <CoreSpinner SizePx="@WakingSpinnerSizePx" />
                </div>
            }
        </article>
    </main>

    @if (ShowBottomNavigation && !_isTorBlocked)
    {
        <AppBottomNav />
    }

    @* Last, and a sibling of the page rather than a descendant of anything in it. Every card in this app is
       frosted, and a frosted ancestor becomes the containing block for everything fixed inside it, so a panel
       meant to cover the screen only covers the card it was opened from. Drawn from here, it covers the window. *@
    <OverlayHost />

    @* Inside the keyed element on purpose: the body background and typography are written from the palette, and
       left outside they would keep the colours of whichever theme was active when the page first loaded. *@
    <MainLayoutCss />
</div>

@code {
    /// <summary> Class added to the page shell so its bottom padding clears the navigation bar. </summary>
    const string HasBottomNavClass = "has-bottom-nav";

    /// <summary> Mark shown while the stored session is being read back. </summary>
    const string WakingEmoji = "🫖";

    /// <summary> Diameter of the throbber on the waking screen. </summary>
    const int WakingSpinnerSizePx = 28;

    /// <summary> Mark on the screen shown when Tor was insisted on and this is not Tor. </summary>
    const string TorBlockedEmoji = "🧅";

    /// <summary> Heading of that screen. </summary>
    const string TorBlockedHeadline = "Not over Tor";

    /// <summary> Line under it, saying what was asked for and what happened. </summary>
    const string TorBlockedDescription =
        "You asked this device to refuse anything that is not Tor, and this is not a Tor address. Nothing has been "
        + "sent. Open the app through your hidden service, or lift the requirement below.";

    /// <summary> Label on the control that lifts the requirement. </summary>
    const string TorBlockedReleaseLabel = "Lift the requirement on this device";

    /// <summary> Mark on the strip shown while a sealed file is being read. </summary>
    const string OfflineEmoji = "📦";

    /// <summary> What that strip says is happening. </summary>
    const string OfflineHeadline = "Reading your archive. Nothing is being talked to.";

    /// <summary> Wording of the line under it; the placeholder takes the day the archive was sealed. </summary>
    const string OfflineDetailFormat = "Sealed {0}. Pictures, sounds and video stayed on the server, so they are not here.";

    /// <summary> Label on the control that points the app back at a server. </summary>
    const string OfflineActionLabel = "Talk to a server again";

    /// <summary> The line under the strip's headline, naming the day the file was sealed. </summary>
    string OfflineDetail => string.Format(OfflineDetailFormat, RelativeTimeFormatter.FormatDate(OfflineReadingService.SealedAtUnixMs));

    /// <summary> Points the app back at the server it was talking to, and redraws the shell without the strip. </summary>
    /// <returns> A task that completes once the stores are wired to that server again. </returns>
    async Task TalkToAServerAgainAsync()
    {
        await OfflineReadingService.TalkToAServerAgainAsync();
        NavManager.NavigateTo(NavigationConstants.Wall.Link, forceLoad: false);
    }

    /// <summary> True while the app must refuse to run because it was not reached over Tor. </summary>
    bool _isTorBlocked;

    /// <summary> True while the navigation bar belongs on screen, which is exactly while an account is unlocked. </summary>
    bool ShowBottomNavigation;

    /// <summary> False until the stored session has been read back, which is what gates the routed page. </summary>
    bool _isSessionReady;

    /// <summary> Palette the shell was last drawn in, so a swap made from a page below is noticed and repainted. </summary>
    string _paintedThemeName = ThemeManager.Current.Name;

    protected override void OnInitialized() => MainEvents.Subscribe(HandleAppEvent);

    /// <summary>
    /// Reads the stored session once the app is running and the browser storage is reachable, then lets the
    /// routed page draw. A session that cannot be reopened is not a failure: the app simply opens signed out.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ThemeManager.RestoreAsync();

            // Restored before anything is drawn, or the first feed would flash uncovered and then cover itself.
            await ContentGuard.RestoreAsync();

            // Same reason: the wall would otherwise draw newest-first and rearrange itself a moment later.
            await FeedRecipe.RestoreAsync();

            // Before the session is opened and before anything is read: a device pointed at another server must
            // reach that server for its very first request, not for its second.
            string chosenServer = await HomeServerService.ReadAsync();
            if (chosenServer.Length > 0) await StoreWiring.ApplyAsync(chosenServer);

            // Asked before the session is opened: somebody who insists on Tor should not have their account
            // unlocked over a connection they already refused.
            _isTorBlocked = await AnonymityService.IsTorOnlyAsync()
                            && !AnonymityService.IsReachedOverTor(NavManager.BaseUri);

            if (!_isTorBlocked) await SessionService.RestoreAsync();
        }
        catch (Exception error)
        {
            Log($"Restoring the stored session failed; opening signed out.\n{error}", LogLevel.Error);
        }
        finally
        {
            ShowBottomNavigation = SessionService.IsSignedIn;
            _isSessionReady = true;
        }

    }

    /// <summary>
    /// Redraws the shell when the palette swaps, and re-reads whether anybody is signed in when the session
    /// changes, so the navigation bar appears the moment an account is created or unlocked and leaves again on
    /// sign-out.
    /// </summary>
    /// <param name="eventName"> Name of the event that fired, one of <see cref="MainEvents.Names"/>. </param>
    /// <param name="data"> Payload the event carried; the shell re-reads what it needs and ignores it. </param>
    void HandleAppEvent(string eventName, object? data)
    {
        if (eventName == MainEvents.Names.SessionChanged) ShowBottomNavigation = SessionService.IsSignedIn;
        else if (eventName is not (MainEvents.Names.ThemeChanged or MainEvents.Names.OfflineReadingChanged)) return;

        InvokeAsync(StateHasChanged);
    }

    /// <summary> Re-reads the palette after every render, so a theme swapped from a page inside the layout still repaints the shell. </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (_paintedThemeName == ThemeManager.Current.Name) return;

        _paintedThemeName = ThemeManager.Current.Name;
        StateHasChanged();
    }

    /// <summary>
    /// Lifts the Tor requirement and lets the app open. Offered here rather than only in settings, because
    /// settings are behind the very screen this is blocking.
    /// </summary>
    /// <returns> A task that completes once the app has opened. </returns>
    async Task ReleaseTorRequirementAsync()
    {
        await AnonymityService.SetTorOnlyAsync(false);
        _isTorBlocked = false;

        await SessionService.RestoreAsync();
        ShowBottomNavigation = SessionService.IsSignedIn;
    }

    public void Dispose() => MainEvents.Unsubscribe(HandleAppEvent);
}
