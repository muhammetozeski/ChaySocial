@namespace ChaySocial.MainProject.UI.Layout

@{
    // Widest the refusal's explanation grows before it wraps.
    const int BlockedTextMaximumWidthPx = 420;

    // Fixed-width faces for the address the app was reached on, where every character is the point.
    const string BlockedMonospaceStack = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";

    // How solid the amber wash behind the offline strip is — enough to be noticed above the page, not enough
    // to read as an error.
    const float OfflineStripTintOpacity = 0.14f;

    // How solid the amber hairline under that strip and around its button is.
    const float OfflineStripEdgeOpacity = 0.35f;

    string cssVars = AppStyles.BuildCssVariables();
    string aurora = AppStyles.BuildAuroraBackground();
    string textColor = AppColors.TextPrimary.ToRgbaHex(true);
    string warningBg = AppColors.Warning.ToRgbaHex(true);
    string warningFg = AppColors.BackgroundDeep.ToRgbaHex(true);
}

<style>
    @((MarkupString)cssVars)

    /* The emoji faces are named ahead of the text stack so every emoji is drawn in colour by whichever of them the
       reader's system has. They are only emoji fonts — none carries a Latin glyph — so text still falls through to
       the stack behind them. The app ships no emoji font of its own: the one in Resources weighs 24 MB, which is
       more than the whole application, and every system this runs on already has one. */
    body {
        margin: 0;
        padding: 0;
        min-height: @(AppMeasures.Viewport.Full)vh;
        overflow-x: hidden;
        font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", "Segoe UI Symbol", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: @textColor;
        @((MarkupString)aurora)
        background-attachment: fixed;
        background-repeat: no-repeat;
        background-size: cover;
    }

    /* The screen shown while the stored session is being read back, before any page is allowed to draw. */
    .app-waking {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Medium)px;
        min-height: @(AppMeasures.Viewport.Most)vh;
    }

    /* The strip that says what is on screen came out of a file. Amber rather than red: this is not a failure,
       it is somebody reading what they own with nothing listening anywhere. */
    .app-offline {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px16)px;
        border-bottom: @(AppMeasures.Border.Thin)px solid @(AppColors.Warning.WithAlpha(OfflineStripEdgeOpacity).ToRgbaHex(true));
        background: @(AppColors.Warning.WithAlpha(OfflineStripTintOpacity).ToRgbaHex(true));
    }

    .app-offline-mark {
        font-size: @(AppMeasures.Font.Large)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .app-offline-text {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-width: 0;
    }

    .app-offline-title {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @(AppColors.TextWarning.ToRgbaHex(true));
    }

    .app-offline-detail {
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: @(AppMeasures.LineHeight.Snug);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .app-offline-action {
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.Warning.WithAlpha(OfflineStripEdgeOpacity).ToRgbaHex(true));
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: transparent;
        color: @(AppColors.TextWarning.ToRgbaHex(true));
        font-family: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        cursor: pointer;
    }

        .app-offline-action:hover {
            background: @(AppColors.Warning.WithAlpha(OfflineStripEdgeOpacity).ToRgbaHex(true));
            color: @(AppColors.TextPrimary.ToRgbaHex(true));
        }

    /* Shown instead of the app when Tor was insisted on and this is not Tor. It fills the screen on purpose:
       a refusal that shares the page with the thing it is refusing is not a refusal. */
    .app-blocked {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Medium)px;
        min-height: @(AppMeasures.Viewport.Most)vh;
        padding: @(AppMeasures.Space.Px24)px;
        text-align: center;
    }

    .app-blocked-mark {
        font-size: @(AppMeasures.Font.Giant)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

    .app-blocked-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textColor;
    }

    .app-blocked-text {
        margin: 0;
        max-width: @(BlockedTextMaximumWidthPx)px;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    /* The address it was actually reached on, so the refusal is checkable rather than merely asserted. */
    .app-blocked-host {
        margin: 0;
        font-family: @BlockedMonospaceStack;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        overflow-wrap: anywhere;
    }

    .app-blocked-release {
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px20)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @(AppColors.BorderSoft.ToRgbaHex(true));
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        font: inherit;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        cursor: pointer;
    }

    .app-waking-mark {
        font-size: @(AppMeasures.Font.Hero)px;
        animation: app-waking-breathe @(AppMeasures.Duration.VerySlow)s ease-in-out infinite;
    }

    @@keyframes app-waking-breathe {
        0%, 100% {
            opacity: @(AppMeasures.Opacity.Dim);
            transform: scale(1);
        }

        50% {
            opacity: 1;
            transform: scale(1.08);
        }
    }

    /* border-box, so the room reserved for the floating navigation is taken out of the viewport height rather than
       added to it. Without it every screen in the app stands exactly one navigation bar taller than the window and
       scrolls that far into empty space. */
    .app-page {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        min-height: @(AppMeasures.Viewport.Full)vh;
        position: relative;
    }

        .app-page.has-bottom-nav {
            padding-bottom: @(AppMeasures.Space.Px90)px;
        }

    /* clip rather than hidden: "hidden" on one axis silently turns the other into a scroll box, which makes this
       element the scrollport every sticky descendant sticks to — and since it grows with its content instead of
       scrolling, a sticky header then rides up the page with everything else. "clip" trims the same overflow
       without claiming the scrolling. */
    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow-x: clip;
    }

    .content {
        flex: 1;
        position: relative;
        animation: pageFadeSlideIn @(AppMeasures.Duration.Normal)s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    #blazor-error-ui {
        background: @warningBg;
        color: @warningFg;
        bottom: 0;
        left: 0;
        width: @(AppMeasures.Percent.Full)%;
        position: fixed;
        padding: 0.6rem 1.25rem 0.7rem 1.25rem;
        display: none;
        z-index: @(AppMeasures.ZLayer.Toast);
    }

        #blazor-error-ui .dismiss {
            cursor: pointer;
            position: absolute;
            right: 0.75rem;
            top: 0.5rem;
        }

    @@keyframes pageFadeSlideIn {
        0% {
            opacity: 0;
            transform: translateY(@(AppMeasures.Space.Px16)px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

