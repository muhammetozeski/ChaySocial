@inject NavigationManager NavManager
@implements IDisposable

<AcrylicBar PinnedToBottom="true" Padding="0 0 env(safe-area-inset-bottom) 0" CustomClass="bottom-nav-container">
    @foreach (var item in NavigationConstants.BottomNavigationItems)
    {
        <button class="nav-item @(_activePath == item.Link ? "active" : "")" @onclick="() => NavManager.NavigateTo(item.Link)">
            <div class="nav-icon-box">
                <span class="nav-icon">@item.Icon</span>
                @if (_activePath == item.Link)
                {
                    <span class="nav-dot"></span>
                }
            </div>
            <span class="nav-label">@item.Title</span>
        </button>
    }
</AcrylicBar>

<AppBottomNavCss />

@code {

    private string _activePath = NavigationConstants.Wall.Link;

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += HandleLocationChanged;
        UpdateActivePath(NavManager.Uri);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateActivePath(e.Location);
        StateHasChanged();
    }

    private void UpdateActivePath(string uri)
    {
        // Normalize to an absolute path like "/wall" so a generated link ("/Wall") can be matched against it.
        // The comparison ignores case: the routes are spelled in Pascal case and a browser address bar is not,
        // and lower-casing one side while comparing ordinally is what left every tab drawn as inactive.
        var absolutePath = "/" + NavManager.ToBaseRelativePath(uri).Split('?', '#')[0];

        // Matched on whole segments rather than any prefix, so a route that merely begins with a tab's name does
        // not light that tab up. Hidden pages match nothing and fall back to string.Empty.
        _activePath = NavigationConstants.BottomNavigationItems
            .FirstOrDefault(item =>
                absolutePath.Equals(item.Link, StringComparison.OrdinalIgnoreCase)
                || absolutePath.StartsWith(item.Link + "/", StringComparison.OrdinalIgnoreCase))
            .Link ?? string.Empty;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
    }
}
